{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coastal task v1.1 status",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "paused"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "task_id",
    "revision",
    "contract_sha256",
    "receipt_sha256",
    "status",
    "reasons"
  ],
  "additionalProperties": false
}
