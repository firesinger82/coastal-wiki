{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coastal task v1.1 run",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "reserved"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "worker",
            "verifier",
            "none"
          ]
        },
        "phase": {
          "type": "string",
          "enum": [
            "purpose",
            "output",
            "worker",
            "none"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "sandbox": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write"
          ]
        },
        "prompt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "binding": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "task_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_][a-z0-9_-]{0,63}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "contract_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "input_sha256s": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "checker_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "output_sha256s": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "required": [
                "task_id",
                "revision",
                "contract_sha256",
                "input_sha256s",
                "checker_sha256",
                "output_sha256s"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "started": {
          "type": "number"
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "process_token": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "prev_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "event",
        "run_id",
        "role",
        "phase",
        "model",
        "argv",
        "sandbox",
        "prompt_sha256",
        "binding",
        "started",
        "pid",
        "process_token",
        "purpose",
        "prev_sha256",
        "entry_sha256"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "event": {
          "const": "finished"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "reservation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ended": {
          "type": "number"
        },
        "exit": {
          "type": "integer"
        },
        "actual_model": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "codex_session_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "output_sha256s": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "verdict_path": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "verdict_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "prev_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "event",
        "run_id",
        "reservation_sha256",
        "ended",
        "exit",
        "actual_model",
        "codex_session_id",
        "output_sha256s",
        "verdict_path",
        "verdict_sha256",
        "error",
        "prev_sha256",
        "entry_sha256"
      ],
      "additionalProperties": false
    }
  ]
}
