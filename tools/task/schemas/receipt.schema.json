{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coastal task v1.1 receipt",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_sha256s": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "checker_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_sha256s": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "approval_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runs_tail_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "exit": {
            "type": "integer"
          },
          "stdout_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stderr_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "verdict",
          "exit",
          "stdout_sha256",
          "stderr_sha256"
        ],
        "additionalProperties": false
      }
    },
    "validate_all": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "exit": {
          "type": "integer"
        },
        "stdout_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stderr_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "verdict",
        "exit",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "additionalProperties": false
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "verdict_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_][a-z0-9_-]{0,63}$"
                },
                "verdict": {
                  "type": "string",
                  "enum": [
                    "PASS",
                    "FAIL",
                    "UNCERTAIN"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "verdict",
                "evidence"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "run_id",
          "model",
          "verdict_sha256",
          "questions"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "build_plan_levels": {
      "type": "object",
      "properties": {
        "target": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "not_performed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "target",
        "not_performed"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "integer",
      "minimum": 0
    },
    "budget_used": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "paused"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "task_id",
    "revision",
    "contract_sha256",
    "input_sha256s",
    "checker_sha256",
    "output_sha256s",
    "approval_sha256",
    "runs_tail_sha256",
    "checks",
    "validate_all",
    "reviews",
    "build_plan_levels",
    "records",
    "budget_used",
    "status",
    "reasons"
  ],
  "additionalProperties": false
}
