{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coastal task v1.1 approval",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_at": {
      "type": "string",
      "minLength": 1
    },
    "approver": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "task_id",
    "revision",
    "contract_sha256",
    "snapshot_sha256",
    "approved_at",
    "approver"
  ],
  "additionalProperties": false
}
