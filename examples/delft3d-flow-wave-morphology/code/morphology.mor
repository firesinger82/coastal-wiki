[MorphologyFileInformation]
   FileCreatedBy = coastal-wiki example template (대표값 — 정확 키워드는 Delft3D-FLOW manual §Morphology)
[Morphology]
   MorFac   = 10.0      ; ★ 형태가속계수 (morphological acceleration factor) — bed 변화를 hydro 대비 ×10 가속
                        ;   근거: delft3d_sediment_morphology.md (updmorfac, bott3d.f90:554). 클수록 장기 morphodynamic
                        ;   가속이나 안정성/정확도 trade-off. MorFac=1 이면 가속 없음.
   MorStt   = 720.0     ; spin-up [min] — hydro 안정화 후 morphology 시작(초기 transient 회피)
   Sus      = 1.0       ; 부유사(suspended) transport 계수
   Bed      = 1.0       ; 소류사(bed-load) transport 계수
   SusW     = 1.0       ; 파에 의한 부유사 (wave-related suspended)
   BedW     = 1.0       ; 파에 의한 소류사 (wave-related bed-load)
   MorUpd   = true      ; bed level 갱신 on (online morphology) — bott3d BODSED=Exner
   EqmBc    = true      ; 경계 평형농도 조건
   DensIn   = false     ; 농도의 density 효과
[Numerics]
   ThetSD   = 0.0       ; bed slope 방향 보정
; transport 공식(iform)은 sediment.sed 또는 .mor 의 formula 지정 — van Rijn(1993/2004)·Bijker·
; Soulsby-van Rijn 등 (근거: delft3d_sediment_transport_formulae.md, iform −1/−2/5/11/12/20).
