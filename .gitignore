# OS
.DS_Store
Thumbs.db
desktop.ini
*~
.*.swp
.*.swo

# Editors
.vscode/
.idea/

# Python tooling
__pycache__/
*.pyc
.venv/
venv/

# Large media (커밋 시 LFS 검토)
*.pdf
*.zip
*.tar.gz
*.7z

# 대용량 raw 데이터
**/raw-data/
**/raw/*.nc
**/raw/*.h5
**/raw/*.mat
# data/ 안 raw NetCDF (NOAA/UKMO/JMA 등에서 재다운 가능 — manifest.md 또는 fetch 스크립트로 재현)
data/**/*.nc
data/**/*.nc.gz
data/**/*.grib
data/**/*.grib2
data/**/*.h5

# NIFS KODC raw (재다운 가능, fetch_nifs_kodc.py 으로 재현)
data/sst-global/nifs-kodc/all_raw.csv
data/sst-global/nifs-kodc/raw_*.json

# Models — vendor source/manuals raw trees (D1, 2026-05-23)
# 이유: 16GB adcirc-testsuite 등 GitHub 공식 repo 1:1 복제. 별도 clone으로 재현 가능 → git push 부담 회피.
# 각 모델의 manifest.md 에 (repo URL, commit/tag, sha) 기록해 reader가 재현.
models/*/raw/source_code/
models/*/raw/manuals/
# 안전 그물 — 흡수 과정 중 raw/ 도입 전 위치를 쓰는 자료 보호
models/*/source_code/adcirc-testsuite/

# OneDrive conflict (혹시 동기화 경로로 옮길 경우 대비)
* (firesinger's conflicted copy *).md
* (*conflicted copy*).md

# Obsidian — 머신별 상태 (PC마다 다름). 나머지 .obsidian/ 설정·플러그인은 sync 유지.
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace*.json
.obsidian/cache
.obsidian/graph.json
.obsidian/types.json
.trash/

# 로컬 스크래치
scratch/
.local/
*.tmp

# Playwright MCP — 페이지 snapshot 임시 (재호출 시 새로 생성)
.playwright-mcp/

# 도구 venv (재생성 가능)
.venv-tools/

# 변환 로그
textbook/md/_conversion.log

# Raw 측정 데이터 — OpenAPI 재다운 가능
tools/khoa-validation/data/
tools/*/data/*.csv

# Secrets (API key 보호)
*.env
.env*
*api_key*
*API_KEY*
!**/README.md

# python bytecode (references/ tooling)
references/__pycache__/
__pycache__/

# llm-wiki PoC index (재생성 가능 파생물)
tools/llm-wiki-poc/*.db
