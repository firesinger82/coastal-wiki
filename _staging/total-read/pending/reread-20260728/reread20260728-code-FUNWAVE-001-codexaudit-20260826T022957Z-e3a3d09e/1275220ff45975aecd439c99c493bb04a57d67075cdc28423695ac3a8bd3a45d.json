imensioned (Mloc,Nloc) at line 83"], "constants": [], "params_defined": [], "equations": [{"expr": "DU(I,J)=Max(Depth(I,J),MinDepthFrc)*U(I,J)", "ref": "depth-weighted x velocity", "loc": 110}, {"expr": "DV(I,J)=Max(Depth(I,J),MinDepthFrc)*V(I,J)", "ref": "depth-weighted y velocity", "loc": 111}, {"expr": "ETAT(I,J)=-(P(I+1,J)-P(I,J))/DX-(Q(I,J+1)-Q(I,J))/DY", "ref": "conservative free-surface time derivative", "loc": 118}, {"expr": "Ut(I,J)=(U(I,J)-U0(I,J))/DT", "ref": "x-velocity time difference", "loc": 136}, {"expr": "Vt(I,J)=(V(I,J)-V0(I,J))/DT", "ref": "y-velocity time difference", "loc": 137}, {"expr": "DUt(I,J)=Max(Depth(I,J),MinDepthFrc)*Ut(I,J)", "ref": "depth-weighted x acceleration", "loc": 139}, {"expr": "DVt(I,J)=Max(Depth(I,J),MinDepthFrc)*Vt(I,J)", "ref": "depth-weighted y acceleration", "loc": 140}, {"expr": "U4(I,J)=(1.0_SP/3.0_SP-Beta_1+0.5_SP*Beta_1*Beta_1)*DEPTH(I,J)*DEPTH(I,J)*(Uxx(I,J)+Vxy(I,J)) +(Beta_1-1.0_SP/2.0_SP)*DEPTH(I,J)*(DUxx(I,J)+DVxy(I,J))", "ref": "linear x dispersive contribution", "loc": 250}, {"expr": "V4(I,J)=(1.0_SP/3.0_SP-Beta_1+0.5_SP*Beta_1*Beta_1)*DEPTH(I,J)*DEPTH(I,J)*(Uxy(I,J)+Vyy(I,J)) +(Beta_1-1.0_SP/2.0_SP)*DEPTH(I,J)*(DUxy(I,J)+DVyy(I,J))", "ref": "linear y dispersive contribution", "loc": 252}, {"expr": "U1p(I,J)=0.5_SP*(1.0_SP-Beta_1)*(1.0_SP-Beta_1)*DEPTH(I,J)*DEPTH(I,J)*(Uxx(I,J)+Vxy(I,J)) +(Beta_1-1.0_SP)*DEPTH(I,J)*(DUxx(I,J)+DVxy(I,J))", "ref": "modified x U1p term", "loc": 281}, {"expr": "V1p(I,J)=0.5_SP*(1.0_SP-Beta_1)*(1.0_SP-Beta_1)*DEPTH(I,J)*DEPTH(I,J)*(Uxy(I,J)+Vyy(I,J)) +(Beta_1-1.0_SP)*DEPTH(I,J)*(DUxy(I,J)+DVyy(I,J))", "ref": "modified y V1p term", "loc": 287}, {"expr": "U1pp(I,J)=-reta*Beta_2*ETAx(I,J)*Beta_2*(Utx(I,J)+Vty(I,J))-0.5_SP*reta*reta*Beta_2*Beta_2*(Utxx(I,J)+Vtxy(I,J))-ETAx(I,J)*Beta_2*(DUtx(I,J)+DVty(I,J))-reta*Beta_2*(DUtxx(I,J)+DVtxy(I,J))", "ref": "nonlinear x time-dispersive term", "loc": 320}, {"expr": "V1pp(I,J)=-reta*Beta_2*ETAy(I,J)*Beta_2*(Utx(I,J)+Vty(I,J))-0.5_SP*reta*reta*B