ons (L21)", "dx — longitude spacing in degrees (L24)", "dy — latitude spacing in degrees (L25)", "x — longitude vector starting 132.01667 (L26)", "y — latitude vector starting -59.98333 (L27)", "wid — figure width in inches (L30)", "len — figure height in inches (L31)", "has_demcmap — logical, Mapping Toolbox presence (L39)", "cbar — colorbar handle (L49)"], "constants": [{"name": "dx", "value": "0.5", "line": 24}, {"name": "dy", "value": "0.5", "line": 25}, {"name": "wid", "value": "6", "line": 30}, {"name": "len", "value": "4", "line": 31}], "params_defined": [{"name": "fdir", "default": "'../external_files/'", "range": "", "loc": 9}, {"name": "plot_color_bars", "default": "true", "range": "true|false", "loc": 12}], "equations": [{"expr": "x=[0:m-1]*dx+132.01667", "ref": "longitude coordinates of the 30-arcmin grid", "loc": 26}, {"expr": "y=[0:n-1]*dy-59.98333", "ref": "latitude coordinates of the 30-arcmin grid", "loc": 27}, {"expr": "has_demcmap = ~isempty(which('demcmap'))", "ref": "Mapping Toolbox capability check", "loc": 39}], "io": [{"kind": "read", "name": "depth_30min.txt (ASCII depth grid via load([fdir ...]))", "loc": 20}, {"kind": "plot", "name": "pcolor of -dep in lon/lat, optional DEM colormap and colorbar", "loc": 36}], "calls": ["clear all (L2)", "load (L20)", "size (L21)", "set(gcf,...) (L32, L53)", "clf (L33)", "pcolor / shading interp (L36)", "which (L39)", "isempty (L39)", "demcmap (L41)", "ylabel (L44)", "xlabel (L45)", "colorbar (L49)", "set(get(cbar,'ylabel'),...) (L50)"], "verbatim_spans": [{"text": "plot_color_bars = true;", "loc": 12}, {"text": "has_demcmap = ~isempty(which('demcmap'));", "loc": 39}, {"text": "set(get(cbar,'ylabel'),'String','-depth (m) ') ", "loc": 50}], "unresolved": ["fdir = '../external_files/' (L9) lacks a trailing semicolon so it echoes to the console; cosmetic only.", "Grid origin values 132.01667/-59.98333 and 0.5-degree spacing are asserted; actual extent depends on depth_30min.txt dimensions not visible here."]}