y @L69", "Hs_output @L73", "reps @L77"], "constants": [{"name": "Energy_total", "value": "0", "line": 8}, {"name": "sigma_spec", "value": "0.09", "line": 19}, {"name": "sigma_spec", "value": "0.07", "line": 21}], "params_defined": [], "equations": [{"expr": "freq_resolution = (fmax-fmin)/(mfreq-1)", "ref": "uniform frequency spacing", "loc": 7}, {"expr": "freq(kf)=fmin+(kf-1)*freq_resolution", "ref": "frequency grid", "loc": 10}, {"expr": "omiga_spec=2*pi*freq(kf)*sqrt(depth/g)", "ref": "dimensionless frequency", "loc": 11}, {"expr": "Etma(kf) = g^2*freq(kf)^(-5)*(2*pi)^(-4)*phi*exp(-5/4*(freq(kf)/fp)^(-4))", "ref": "spectral density continued through L25", "loc": 24}, {"expr": "N_spec = 20/sigma_theta", "ref": "directional series term limit", "loc": 30}, {"expr": "freq = freq+diff", "ref": "frequency-grid shift", "loc": 33}, {"expr": "idx_theta = mod(displace_theta,mtheta)", "ref": "directional phase index", "loc": 36}, {"expr": "AG(kf) = AG(kf) + (1/pi)*exp(-0.5*(k_n*sigma_theta)^2)", "ref": "directional Fourier weight continued through L51", "loc": 50}, {"expr": "alpha_spec = Hmo^2/16/Energy_total", "ref": "height normalization", "loc": 64}, {"expr": "correction_coeff = Energy_total/sum(AG.*EnergyBin)", "ref": "directional-weight correction", "loc": 65}, {"expr": "Spectrum_Energy(kf) = (Hmo_each(kf)/4).^2 / freq_resolution / pi", "ref": "component spectral energy", "loc": 69}, {"expr": "Hs_output = sqrt(sum(Hmo_each.^2))", "ref": "reconstructed significant height", "loc": 73}], "io": [{"kind": "load", "name": "inputs.mat", "loc": 4}], "calls": ["load @L4", "sqrt @L11,L68,L73", "exp @L24-L25,L50", "min @L32,L35", "abs @L32,L35,L53", "mod @L36,L38", "floor @L43", "real @L44", "round @L45", "cos @L51", "sum @L65,L73", "ones @L77"], "verbatim_spans": [{"text": "[diff,~] = min(abs(freq-fp));", "loc": 32}, {"text": "host_freqs_idx = idx_theta:mtheta:mfreq;", "loc": 56}, {"text": "reps = ones(1,mfreq);", "loc": 77}], "unresolved": ["L32 computes only the nonnegative magnitude of the nearest-grid difference, then L33 always adds it to every frequency; when the nearest frequency lies above fp, this shifts it farther above fp instead of locking fp to a component.", "idx_theta can be zero or exceed mfreq at L36; L56 can then produce [0] or an empty vector, L58 may delete its only element, and L57/L60 index the first/end element without an emptiness check.", "No guards precede divisors mfreq-1 (L7), sigma_theta (L30), real(mtheta)-1.0 (L44), Energy_total (L64), sum(AG.*EnergyBin) (L65), or freq_resolution (L69), so boundary/degenerate inputs can make the later normalization singular.", "The function has no input arguments (L1-L2) and obtains fmax, fmin, mfreq, depth, g, fp, gamma_spec, sigma_theta, mtheta, theta_mean, and Hmo only through the dynamic load at L4, leaving its executable interface dependent on inputs.mat contents.", "Hs_output is assigned at L73 but is neither returned in L1-L2 nor subsequently used."]}}