aram.txt", "loc": 7}, {"kind": "read-fields", "name": "Mglob,Nglob,DX,DY,dep_channel,width_channel,slope", "loc": 9}, {"kind": "write", "name": "depth.txt", "loc": 37}, {"kind": "format", "name": "100 FORMAT(9000f12.6)", "loc": 41}], "calls": ["TRIM @L7", "ALLOCATE @L18", "abs @L30,L32"], "verbatim_spans": [{"text": "Y(I,J)=(J-Nglob*0.5)*DY", "loc": 24}, {"text": "IF(abs(Y(I,J))>width_channel*0.5)THEN", "loc": 30}, {"text": "100      FORMAT(9000f12.6)", "loc": 41}], "unresolved": ["Even Nglob produces an off-center Y range at L24; the absolute-value bank rule then gives unequal side extents/depths.", "Mglob values beyond the 9000 descriptors at L41 can cause format reversion and split a J row across records.", "Dimensions, spacings, width, slope, and resulting depth are unvalidated; I/O/allocation statuses are unchecked.", "Three case-local byte-identical copies require synchronized fixes."]}}