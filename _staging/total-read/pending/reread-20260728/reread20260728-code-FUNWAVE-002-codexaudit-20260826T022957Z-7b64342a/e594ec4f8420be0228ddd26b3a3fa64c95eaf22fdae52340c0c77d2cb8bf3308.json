 "default": "100", "range": "", "loc": 22}, {"name": "a", "default": "1.5", "range": "", "loc": 22}, {"name": "sig2", "default": "xc*xc/4", "range": "", "loc": 22}, {"name": "bet", "default": "2", "range": "", "loc": 22}, {"name": "wid", "default": "6", "range": "", "loc": 52}, {"name": "len", "default": "6", "range": "", "loc": 53}], "equations": [{"expr": "x=(-11:dx:5*xcell)", "ref": "generation x coordinates", "loc": 23}, {"expr": "y=(dy/2:dy:ncell*ycell-dy/2)", "ref": "cell-centered generation y coordinates", "loc": 23}, {"expr": "h=s*xx", "ref": "planar base slope", "loc": 27}, {"expr": "yc=(0:ncell)*ycell", "ref": "periodic channel centers", "loc": 31}, {"expr": "h=h-a*exp( -(  ( xx-xc ).^2 + bet*(yy-yc(index)).^2)/sig2 )", "ref": "Gaussian channel subtraction", "loc": 39}], "io": [{"kind": "write", "name": "depth_a15.txt", "loc": 49}, {"kind": "plot", "name": "contour and signed-depth pcolor", "loc": 47}], "calls": ["meshgrid @L24", "exp @L39", "contour @L47,L62", "save @L49", "figure/set @L51-L54", "size/pcolor/colorbar @L55-L59"], "verbatim_spans": [{"text": "%  yc(ncell/2)=yc(ncell/2)-0.25*ycell;", "loc": 35}, {"text": "h(h>8)=8;", "loc": 43}, {"text": "xx=[0:m-1]*dx;", "loc": 56}, {"text": "yy=[0:n-1]*dy;", "loc": 57}], "unresolved": ["Generation uses x starting at -11 and y starting at 1 (L23-L24), but the diagnostic reconstructs x and y from zero at L56-L57, shifting the displayed coordinates by +11 m and -1 m relative to the Gaussian calculation.", "The commented symmetry edit at L35 uses `yc(ncell/2)`. For ncell=2, yc has entries for centers 0,100,200 and MATLAB index ncell/2=1 selects the edge center at 0 rather than the middle center at index 2; if the intended target is the central cell, this is an off-by-one index.", "The saved depth matrix at L49 contains no coordinates, leaving the intended relationship between generation offsets and model-grid origin unstated."]}}