", "default": "20", "range": "", "loc": 103}, {"name": "sx", "default": "6", "range": "", "loc": 104}, {"name": "sy", "default": "6", "range": "", "loc": 105}], "equations": [{"expr": "x=[0:m-1]*dx", "ref": "x coordinates", "loc": 21}, {"expr": "y=[0:n-1]*dy", "ref": "y coordinates", "loc": 22}, {"expr": "[w w_ang]=curl(xx,yy,u,v)", "ref": "velocity curl", "loc": 78}], "io": [{"kind": "interactive-input", "name": "nstart", "loc": 32}, {"kind": "interactive-input", "name": "nend", "loc": 33}, {"kind": "read", "name": "dep.out", "loc": 17}, {"kind": "read", "name": "umean_,vmean_,eta_,mask_ indexed fields", "loc": 46}, {"kind": "plot", "name": "eta/vorticity/depth-velocity panels", "loc": 61}], "calls": ["load @L17,L46-L49", "size/meshgrid @L18,L25", "input @L32-L33", "sprintf @L43", "pcolor/caxis/colorbar @L63-L101", "curl @L78", "plot @L88", "contourf @L95", "quiver @L106", "pause @L111"], "verbatim_spans": [{"text": "dep(mask<1)=NaN;", "loc": 54}, {"text": "[w w_ang]=curl(xx,yy,u,v);", "loc": 78}, {"text": "caxis([-12 0])", "loc": 96}, {"text": "caxis([-12 2.5])", "loc": 101}], "unresolved": ["`dep` is loaded once at L17 but destructively masked inside the multi-frame loop at L54. Cells masked in an earlier frame remain NaN on later frames even if later masks mark them wet, so the bathymetry panel accumulates historical dry regions.", "The depth subplot's caxis is set to [-12,0] at L96 and then overwritten by [-12,2.5] at L101 on the same axes.", "The absolute Windows fdir at L8 mixes backslashes with a trailing slash and ties the script to one workstation; there is no existence check before loads.", "No shared-shape check precedes masking and curl of dep/u/v/eta/mask. `w_ang` and `icount` are unused after assignment, and nstart/nend are unvalidated."]}}