efault": "8", "range": "", "loc": 19}], "equations": [{"expr": "x=[0:m-1]*dx", "ref": "1-D coordinates", "loc": 10}, {"expr": "dep=zeros(m)+10.0", "ref": "nominal depth initialization", "loc": 11}, {"expr": "dep(x>Xslp)=10.0-(x(x>Xslp)-Xslp)*SLP", "ref": "post-toe linear slope", "loc": 12}], "io": [{"kind": "read", "name": "eta_<fnum>", "loc": 25}, {"kind": "display", "name": "four bathymetry/elevation subplots", "loc": 27}], "calls": ["zeros @L11", "length/sprintf/load @L23-L25", "subplot/plot/axis/grid @L27-L32", "num2str @L35"], "verbatim_spans": [{"text": "dep=zeros(m)+10.0;", "loc": 11}, {"text": "plot(x,-dep,'k',x,eta,'b','LineWidth',2)", "loc": 29}, {"text": "title([' Time = ' num2str(files(num)*10) ' sec '])", "loc": 35}], "unresolved": ["`zeros(m)` at L11 creates a 1024-by-1024 matrix, not a 1-by-1024 bathymetry vector. The logical assignment at L12 updates only selected linear entries among the first 1024 elements, and plot(x,-dep,...) at L29 treats the matrix as many series instead of one profile. This is a deterministic dimensional bug; initialization should specify a vector shape.", "Displayed time is files(num)*10 at L35 with no output-cadence metadata. The axis extends to x=1024 at L31 while the generated vector ends at 1023, a minor fixed-range mismatch.", "The absolute input path is unchecked, eta shape is not validated against x, and the script has no file-output call."]}}