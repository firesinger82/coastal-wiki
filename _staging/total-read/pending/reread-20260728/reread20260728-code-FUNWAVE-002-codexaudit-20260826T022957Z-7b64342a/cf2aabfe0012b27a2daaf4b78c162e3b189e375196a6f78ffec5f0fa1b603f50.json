": "dep_flat", "default": "2.0", "range": "", "loc": 5}, {"name": "rat", "default": "1.005", "range": "", "loc": 7}, {"name": "xstart", "default": "250", "range": "", "loc": 13}, {"name": "ystart", "default": "0.0", "range": "", "loc": 14}, {"name": "widthx", "default": "350.0", "range": "", "loc": 15}, {"name": "widthy", "default": "150.0", "range": "", "loc": 16}, {"name": "sizes", "default": "[60 70 80]", "range": "", "loc": 18}, {"name": "nums", "default": "[6 6 6]", "range": "", "loc": 19}], "equations": [{"expr": "x0{kk}=floor(xstart+rand(nums(kk),1)*widthx)", "ref": "random x origin", "loc": 23}, {"expr": "y0{kk}=floor(ystart+rand(nums(kk),1)*widthy)", "ref": "random y origin", "loc": 25}, {"expr": "sum_zzz=(sum_zzz-mn)/(mm-mn)", "ref": "min-max normalization", "loc": 55}, {"expr": "dep=dep-sum_zzz*dep_flat/rat", "ref": "relief-adjusted base depth", "loc": 57}, {"expr": "slope(:,i)=10.0-0.03*(i-1)", "ref": "linear x slope", "loc": 85}, {"expr": "dep=dep+slope", "ref": "final bathymetry", "loc": 88}], "io": [{"kind": "plot-write", "name": "./plots/depth_pcolor.jpg", "loc": 79}, {"kind": "plot-write", "name": "./plots/depth_mesh.jpg", "loc": 103}, {"kind": "plot-write", "name": "./plots/depth_1d.jpg", "loc": 111}, {"kind": "write", "name": "depth_656x200.txt", "loc": 113}], "calls": ["rng/rand/floor @L21-L26", "zeros @L29,L39,L83", "figure/set/plot @L31-L44", "peaks @L45", "max/min @L53-L54", "subplot/pcolor/shading/colorbar @L67-L77", "mesh/view @L96-L97", "print @L79,L103,L111", "save @L113"], "verbatim_spans": [{"text": "y0{kk}=floor(ystart+rand(nums(kk),1)*widthy);", "loc": 25}, {"text": "zzz(yy1:yy1+sizes(kk)-1, xx1:xx1+sizes(kk)-1)=zz(:,:);", "loc": 46}, {"text": "ylabel('points in x')", "loc": 77}, {"text": "save -ASCII depth_656x200.txt dep", "loc": 113}], "unresolved": ["Random origins are not bounded by feature size and MATLAB's 1-based matrix indices. With ystart=0 and widthy=150 (L14-L16,L25), `yy1` can be zero, while the insertion at L46 uses it directly as an index. Also y0 can approach 149 and sizes reach 80, exceeding n=200; x0 can approach 599 and size 80 exceeds m=656. The seeded draws may or may not hit each invalid case, but the declared sampling range permits deterministic out-of-bounds failures.", "Min-max normalization at L53-L55 has no guard for `mm==mn`; empty/zero feature settings or an all-clipped relief would divide by zero and contaminate `dep` at L57.", "The second pcolor panel calls ylabel twice at L76-L77, with the latter text `points in x`; this is a copy/paste error that overwrites the y label instead of setting xlabel.", "`k=30` at L4 is never read. Plot writes assume the `plots` directory already exists."]}}