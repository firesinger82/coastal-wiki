ge": "", "loc": 15}, {"name": "ax", "default": "[0 6550 0 1990]", "range": "", "loc": 18}, {"name": "files", "default": "[90:90]", "range": "", "loc": 20}, {"name": "sc", "default": "50", "range": "", "loc": 63}, {"name": "sk", "default": "5", "range": "", "loc": 64}], "equations": [{"expr": "x=[0:m-1]*dx", "ref": "x coordinates", "loc": 8}, {"expr": "y=[0:n-1]*dy", "ref": "y coordinates", "loc": 9}, {"expr": "uu=sqrt(u.^2+v.^2)", "ref": "speed magnitude", "loc": 37}, {"expr": "[vort vort1]=curl(xx,yy,u,v)", "ref": "curl outputs", "loc": 38}, {"expr": "time=num2str(files(num)*20,'%0.1f')", "ref": "nominal time label", "loc": 40}], "io": [{"kind": "read", "name": "dep.out", "loc": 4}, {"kind": "read", "name": "u_,v_,eta_,mask_ indexed fields", "loc": 26}, {"kind": "write", "name": "snap.jpg", "loc": 79}], "calls": ["load @L4,L26-L29", "size/meshgrid @L7,L10", "figure/set @L13,L16", "sprintf @L24", "sqrt/curl/num2str @L37-L40", "subplot/contourf/caxis/contour/colorbar @L46-L68", "pcolor/quiver @L59,L65", "print @L79"], "verbatim_spans": [{"text": "eta(mask<1)=NaN;", "loc": 31}, {"text": "%u(mask<1)=NaN;", "loc": 34}, {"text": "hp=pcolor(xx,yy,uu);shading interp", "loc": 59}, {"text": "print -djpeg snap.jpg", "loc": 79}], "unresolved": ["The only active mask applications target `eta` and `dep1` at L31-L32, but neither variable is plotted afterward. Masking of u/v is commented out at L34-L35, so `uu` at L37 and the speed/quiver plot at L59-L65 include dry-cell velocity values; the apparent wet/dry safeguard is ineffective.", "`vort`, `vort1`, and `time` are computed at L38-L40 but never used; the corresponding title is commented at L73, indicating copied movie logic that does not affect this snapshot.", "No size check ensures dep, eta, mask, u, and v share dimensions before logical indexing and plotting (L26-L38).", "The output-index-to-time factor 20 at L40 is hard-coded and unverified, while `files=[90:90]` at L20 fixes the loop to a single snapshot."]}}