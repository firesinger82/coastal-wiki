WANT_HALF_CORES_ONLY", "default": "unset", "range": "unset or YES", "loc": 50}, {"name": "DISABLE_PSM_ADJUSTMENTS", "default": "unset", "range": "unset or YES", "loc": 57}, {"name": "SHOW_MPI_DEBUGGING", "default": "unset", "range": "unset or YES", "loc": 63}, {"name": "OPENMPI_FLAGS", "default": "--display-map --mca btl ^tcp", "range": "base flags plus conditionally appended binding, process-count, debugging, and reporting flags", "loc": 68}], "equations": [{"expr": "np = NSLOTS/2 when WANT_HALF_CORES_ONLY=YES", "ref": "shell arithmetic in --np option", "loc": 73}], "io": [{"kind": "input", "name": "Grid Engine environment variables NSLOTS and NHOSTS", "loc": 73}, {"kind": "output", "name": "Grid Engine/OpenMPI diagnostics", "loc": 91}, {"kind": "execute", "name": "MY_EXE through mpirun", "loc": 98}], "calls": [{"name": "source /opt/shared/valet/docs/valet.sh", "loc": 32}, {"name": "vpkg_require openmpi/1.4.4-gcc", "loc": 33}, {"name": "psm-max-sharedcontexts", "loc": 83}, {"name": "which mpirun", "loc": 92}, {"name": "mpirun", "loc": 98}], "verbatim_spans": [{"text": "#$ -pe openmpi 4", "loc": 16}, {"text": "#$ -l  psm_endpoints=1", "loc": 17}, {"text": "MY_EXE=\"./funwave_mills\"", "loc": 38}, {"text": "OPENMPI_FLAGS=\"--display-map --mca btl ^tcp\"", "loc": 68}, {"text": "mpirun ${OPENMPI_FLAGS} $MY_EXE", "loc": 98}], "unresolved": ["The usage text tells the user to modify NPROC, but the active parallel-environment directive contains a literal 4 and defines no NPROC variable (lines 6-8, 16).", "The script has no shebang and relies on site-specific /opt/shared paths, Grid Engine variables, and legacy OpenMPI 1.4.4 resources that are not defined within the file."]}}