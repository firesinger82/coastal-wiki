        "body_paragraph_zero_based": 424,
        "direct_body_paragraph_zero_based": 90,
        "paragraph_id": null,
        "text": "Where  is the dynamic pressure normalized with the reference density and  is the atmospheric pressure, that is assumed to be uniform and stationary."
