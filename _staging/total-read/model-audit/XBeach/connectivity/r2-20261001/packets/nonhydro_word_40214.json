        "start_xml_ordinal": 9104,
        "body_paragraph_zero_based": 438,
        "direct_body_paragraph_zero_based": 104,
        "paragraph_id": null,
        "text": "A similar condition is imposed at the bottom and this leads to the kinematic boundary condition at the bottom"
