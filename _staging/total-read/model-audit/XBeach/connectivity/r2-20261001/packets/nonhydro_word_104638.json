        "start_xml_ordinal": 16155,
        "body_paragraph_zero_based": 621,
        "direct_body_paragraph_zero_based": 279,
        "paragraph_id": null,
        "text": "Assuming that the wave form remains constant along the individual wave rays each of the harmonics obeys"
