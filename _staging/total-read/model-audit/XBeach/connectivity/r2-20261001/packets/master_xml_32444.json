        "direct_body_paragraph_zero_based": 783,
        "paragraph_id": "7B43CD1C",
        "text": "The influence of the bed slope on the local hydrodynamics is not considered in XBeach."
      },
      {
        "container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_master.docx",
