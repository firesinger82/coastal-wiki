        "body_paragraph_zero_based": 4326,
        "direct_body_paragraph_zero_based": 1852,
        "paragraph_id": "21B4B861",
        "text": "The other three fluxes are computed in a similar way; for brevity we will not present all formulations."
      },
      {
        "container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_master.docx",
        "member": "word/document.xml",
        "start_xml_ordinal": 87930,
        "body_paragraph_zero_based": 4328,
        "direct_body_paragraph_zero_based": 1854,
        "paragraph_id": "014E156E",
        "text": "The time integration is explicit and the same as in the original implementation. The advection in u- and v-direction is computed simply by adding the four fluxes and dividing by the cell area. This procedure guarantees conservation of wave energy."
      }
    ],
    "following_nonempty_paragraphs": [
      {
        "container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_master.docx",
        "member": "word/document.xml",
        "start_xml_ordinal": 88023,
        "body_paragraph_zero_based": 4331,
        "direct_body_paragraph_zero_based": 1857,
        "paragraph_id": "0D83F98D",
        "text": "The procedure for the roller energy balance is identical to that for the wave energy balance and will not be repeated here."
      },
      {
        "container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_master.docx",
        "member": "word/document.xml",
        "start_xml_ordinal": 88031,
        "body_paragraph_zero_based": 4332,
        "direct_body_paragraph_zero_based": 1858,
        "paragraph_id": "4E90E75F",
        "text": "Stationary solver"
      }
    ],
