        "direct_body_paragraph_zero_based": 422,
        "paragraph_id": "55232004",
        "text": "Not taking into account the turbulence variance at the bed (keyword: turb = none)"
      },
      {
        "container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_master.docx",
