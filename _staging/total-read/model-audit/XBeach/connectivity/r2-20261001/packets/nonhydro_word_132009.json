        "start_xml_ordinal": 20004,
        "body_paragraph_zero_based": 736,
        "direct_body_paragraph_zero_based": 381,
        "paragraph_id": null,
        "text": "Although this coefficient has no physical meaning it introduces an extra degree of freedom in the numerical dispersion relation. Equation (2.1) now becomes"
