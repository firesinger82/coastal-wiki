{"id": "kingsday:xml:97449", "association": {"status": "unique", "objects": [{"kind": "ole", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "xml_ordinal": 97437, "paragraph_xml_ordinal": 97421}, "relationship": {"id": "rId324", "target": "embeddings/oleObject144.bin", "type": "http://schemas.openxmlformats.org/officeDocument/2006/relationships/oleObject", "member": "word/embeddings/oleObject144.bin"}, "ole": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx!word/embeddings/oleObject144.bin", "storage": "zip-member", "container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/embeddings/oleObject144.bin", "sha256": "b8551fe5d105c9f049dd5cfccf6b7b4a6a3be17364dd9721b4b7b911890adccb"}, "prog_id": "Equation.DSMT4", "shape_id": "_x0000_i1168", "object_id": "_1508071272", "previews": [{"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx!word/media/image167.wmf", "storage": "zip-member", "container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/media/image167.wmf", "sha256": "f37378ab0502b7ed8f7bb71cabbc0910e88d21be3d639a08dd67a02ba5086cff", "relationship": {"id": "rId323", "target": "media/image167.wmf", "type": "http://schemas.openxmlformats.org/officeDocument/2006/relationships/image", "member": "word/media/image167.wmf"}, "xml_ordinal": 97436}], "preview_binding_status": "unique", "member": null}], "page": 133}, "body_status": "readable", "equation_content": {"images_used": [{"path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-133.png", "region": "B.24, top expanded nonhydrostatic flux block", "sha256": "577583658a286ce0d479021dbcbc09a3bd70b40b77386a1a270d6fdac21598a0"}, {"path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "region": "Explicit definition for q_gw^x at paragraph 97215", "sha256": "2cf872157095288f986c04015ea7ff6c8f7e22f9e313ddea9023ead0de61a434"}], "transcription": "q_gw,i,j^x=-K_u,i,j Δz_u,i,j (H_i+1,j-H_i,j)/Δx_u,i,j=-K_u,i,j Δz_u,i,j [H_bc,i+1,j-(2/3)β_i+1,j Δz_H,i+1,j^2-H_bc,i,j+(2/3)β_i,j Δz_H,i,j^2]/Δx_u,i,j; q_gw,i,j^y=-K_v,i,j Δz_v,i,j (H_i+1,j-H_i,j)/Δy_v,i,j=-K_v,i,j Δz_v,i,j [H_bc,i+1,j-(2/3)β_i+1,j Δz_H,i+1,j^2-H_bc,i,j+(2/3)β_i,j Δz_H,i,j^2]/Δy_v,i,j", "uncertain_symbols": [], "reviewer_note": "S2: independently reopened the saved render page with tools.view_image (including original detail where needed). AI visual transcription; not mathematical validation. Retains all printed spatial indices, time levels, letter case, vector arrows, and odd/repeated notation. Typographic observations describe the document and are not classified as code differences."}, "document_role": "model_relation", "implementation_relation": "mapped_with_differences", "evidence_origin": [{"origin": "new_comparison", "ref": "_staging/total-read/model-audit/XBeach/connectivity/r2-20261001/packets/kingsday_xml_97449.json", "claims_resolved": ["Caption-local visual transcription from actually opened saved images; structural association preserved.", "For GWHEADMODEL_PARABOLIC, H=hbc-(2/3)*gwcurv*gwheight² exactly supplies the written expanded x-gradient. Horizontal velocity then uses -Kin*headgrad, multiplied by interface heights.", "S1 full-document definition search: new links q_gw^x, q_gw^y, Δz_u, Δz_v; explicit existing naming/definition links retained.", "S3 actual conductivity argument/reset chain and independent gwnonh/wavemodel switches."], "gaps_left": ["B.21/B.23 define the Δz/q_gw symbols; the y-neighbor discrepancy remains unresolved.", "Remaining formal literal-symbol definitions: Δx_u, Δy_v. This list alone does not imply unresolved closure.", "The pressure/velocity conductivity consistency asserted by the source comment is not established by the executable code; intended-method/conservation consequences are unverified."]}], "document_differences": [{"other_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97300}, "difference": "B.24 repeats i+1,j in the y-line despite the longshore y definition."}], "symbols": [{"symbol": "q_gw^x", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97215, "render_image": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "definition_basis": "printed defining equation or symbol-bearing clause"}, "definition_quote": "q_gw,i,j^x=-K_u,i,j Δz_u,i,j (H_i+1,j-H_i,j)/Δx_u,i,j=-K_u,i,j Δz_u,i,j (H_bc,i+1,j-H_bc,i,j)/Δx_u,i,j", "meaning": "horizontal groundwater discharge x component, defined by B.23; x/u directions named at paragraph 97300"}, {"symbol": "q_gw^y", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97215, "render_image": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "definition_basis": "printed defining equation or symbol-bearing clause"}, "definition_quote": "q_gw,i,j^y=-K_v,i,j Δz_v,i,j (H_i+1,j-H_i,j)/Δy_v,i,j=-K_v,i,j Δz_v,i,j (H_bc,i+1,j-H_bc,i,j)/Δy_v,i,j", "meaning": "horizontal groundwater discharge y component, defined by B.23; the printed i+1,j neighbor remains distinct from the direction definition"}, {"symbol": "K", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 24669}, "definition_quote": "K is the hydraulic conductivity of the medium (keyword: kx, ky, kz, for each horizontal and vertical direction)", "meaning": "hydraulic conductivity; directional keyword correspondence is explicit"}, {"symbol": "Δz_u", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96862, "render_image": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "definition_basis": "printed defining equation or symbol-bearing clause"}, "definition_quote": "Δz_u,i,j={Δz_H,i+1,j if q_gw,i,j^x<0; Δz_H,i,j if q_gw,i,j^x≥0}", "meaning": "upwind groundwater cell height at the u interface, defined by B.21"}, {"symbol": "Δz_v", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96862, "render_image": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "definition_basis": "printed defining equation or symbol-bearing clause"}, "definition_quote": "Δz_v,i,j={Δz_H,i+1,j if q_gw,i,j^y<0; Δz_H,i,j if q_gw,i,j^y≥0}", "meaning": "upwind groundwater cell height at the v interface, defined by B.21; the printed i+1,j on the y-flow branch is retained"}, {"symbol": "Δz_H", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96825}, "definition_quote": "The cell height at the center of the groundwater cells (ΔzH,i,j)", "meaning": "groundwater cell height at the cell center"}, {"symbol": "H", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 24669}, "definition_quote": "H is the hydraulic head", "meaning": "hydraulic head; paragraph 25494 further names the mean vertical groundwater head"}, {"symbol": "H_bc", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96947}, "definition_quote": "the head applied on the top boundary of the groundwater domain (Hbc)", "meaning": "groundwater top-boundary hydraulic head"}, {"symbol": "β", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 25494}, "definition_quote": "the groundwater head parabolic curvature coefficient (β)", "meaning": "parabolic groundwater-head curvature coefficient"}, {"symbol": "Δx_u", "definition_locator": null, "definition_quote": null, "meaning": "undefined_in_document"}, {"symbol": "Δy_v", "definition_locator": null, "definition_quote": null, "meaning": "undefined_in_document"}, {"symbol": "i,j", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 94025}, "definition_quote": "The indices i,j refer to the grid number in u resp. v direction", "meaning": "flow/sediment grid indices in u and v directions"}, {"symbol": "u,v", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97300}, "definition_quote": "the subscripts u and v refer to variables approximated at the horizontal cell interfaces in the cross-shore and longshore direction, respectively", "meaning": "cross-shore and longshore face locations"}, {"symbol": "x,y", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97300}, "definition_quote": "the superscripts x and y refer to the components of the variable in the cross-shore and longshore direction, respectively", "meaning": "cross-shore and longshore components"}, {"symbol": "H (subscript)", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97510}, "definition_quote": "the subscript H refers to variables approximated at the cell centers", "meaning": "cell-center location subscript; distinguish this from hydraulic head H"}], "evidence": [{"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 910, "line_end": 916, "quote": "         select case (par%gwheadmodel)\n          case (GWHEADMODEL_PARABOLIC)\n            s%gwhead(2:s%nx,j) = hbc(2:s%nx,j) - twothird*x(:,1)*s%gwheight(2:s%nx,j)**2\n          case (GWHEADMODEL_EXPONENTIAL)\n            s%gwhead(2:s%nx,j) = hbc(2:s%nx,j)+ &\n            x(:,1)/s%gwheight(2:s%nx,j)*sinh(s%gwheight(2:s%nx,j)) &\n            -x(:,1)*cosh(s%gwheight(2:s%nx,j))", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1100, "line_end": 1105, "quote": "         select case (par%gwheadmodel)\n          case (GWHEADMODEL_PARABOLIC)\n            s%gwhead = hbc - twothird*s%gwcurv*s%gwheight**2\n          case (GWHEADMODEL_EXPONENTIAL)\n            s%gwhead = hbc + s%gwcurv/s%gwheight*sinh(s%gwheight) &\n            - s%gwcurv*cosh(s%gwheight)", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 775, "line_end": 782, "quote": "            dheaddx(i,j)=(gwhead(i+1,j)-gwhead(i,j))/dsu(i,j)\n         end do\n      end do\n\n      do j=1,ny\n         do i=1,nx+1\n            dheaddy(i,j)=(gwhead(i,j+1)-gwhead(i,j))/dnv(i,j)\n         end do", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1311, "line_end": 1322, "quote": "            call gw_calculate_velocities_local(gwu(i,j),Kxupd(i,j),dheaddx(i,j),Kx(i,j),0.d0, &\n            par%gwscheme,.false.,par%wavemodel==WAVEMODEL_NONH,par%gwheadmodel, &\n            s%gwcurv(i,j),s%gwheight(i,j),vcr)\n         enddo\n      enddo\n      ! v-direction\n      do j=1,s%ny+1\n         do i=1,s%nx+1\n            call gw_calculate_velocities_local(gwv(i,j),Kyupd(i,j),dheaddy(i,j),Ky(i,j),0.d0, &\n            par%gwscheme,.false.,par%wavemodel==WAVEMODEL_NONH,par%gwheadmodel, &\n            s%gwcurv(i,j),s%gwheight(i,j),vcr)\n         enddo", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1360, "line_end": 1369, "quote": "         else       ! horizontal flow\n            vel = -Kin*headgrad\n         endif\n         Kupd = Kin\n       case (GWSCHEME_TURBULENT)\n         if (isvert .and. isnonh) then  ! vertical flow non-hydrostatic\n            select case(headmodel)\n             case (GWHEADMODEL_PARABOLIC)\n               vest = -Kin*2*gwc*gwh\n               if (abs(vest)>vcr) then", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1426, "line_end": 1434, "quote": "            else\n               Kupd = Kin\n            endif\n            if (isnonh) then\n               vel = -Kin*headgrad ! result bound by pressure solver estimate, will\n               ! update next time step with better K approximation\n            else\n               vel = -Kupd*headgrad\n            endif", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 426, "line_end": 442, "quote": "      ! Stop cells from drying up\n      if (s%ny>0) then\n         do i=2,s%nx\n            do j=2,s%ny\n               if (s%gwlevel(i,j)<=s%gwbottom(i,j)+par%eps) then\n                  s%gwqx(i,j) = min(s%gwqx(i,j),0.d0) ! let no water out, only in\n                  s%gwqx(i-1,j) = max(s%gwqx(i-1,j),0.d0) ! let no water out, only in\n                  s%gwqy(i,j) = min(s%gwqy(i,j),0.d0) ! let no water out, only in\n                  s%gwqy(i,j-1) = max(s%gwqy(i,j-1),0.d0) ! let no water out, only in\n               endif\n            enddo\n         enddo\n      else\n         do i=2,s%nx\n            if (s%gwlevel(i,1)<=s%gwbottom(i,1)+par%eps) then\n               s%gwqx(i,1) = min(s%gwqx(i,1),0.d0) ! let no water out, only in\n               s%gwqx(i-1,1) = max(s%gwqx(i-1,1),0.d0) ! let no water out, only in", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "H is the hydraulic head", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 24669}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "the head applied on the top boundary of the groundwater domain (Hbc)", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96947}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "the groundwater head parabolic curvature coefficient (β)", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 25494}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "The indices i,j refer to the grid number in u resp. v direction", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 94025}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "the superscripts x and y refer to the components of the variable in the cross-shore and longshore direction, respectively", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97300}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "the subscript H refers to variables approximated at the cell centers", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97510}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "In the case of non-hydrostatic groundwater flow, the horizontal specific discharge on each cell interface can be found through an approximation of the non-hydrostatic groundwater head gradient:", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97398}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "Continuity in the groundwater cell is found following:", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97594}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 373, "line_end": 397, "quote": "      if (par%gwnonh == 0) then\n         ! hydrostatic pressure assumption, with time delay required for\n         ! stability\n         !     factime = min(par%dt/0.2d0,1.d0)\n         !     gwhead = (1.d0-factime)*gwhead + factime*gwheadtop\n         s%gwhead = (s%gwhead + gwheadtop)/2\n      else\n         ! non-hydrostatic pressure, solve using Poisson solver. Kxupd is the\n         ! updated hydraulic conductivity from the previous time step\n         call gw_solver(par,s,gwheadtop,Kxupd,Kyupd,Kzupd,gwhu,gwhv,fracdt)\n      endif\n      !\n      !\n      ! Calculate groundwater velocities\n      ! We use Kxupd input which is the same value as sent into the Poisson solver in\n      ! the previous command. In the case of the non-hydrostatic solver, we must force\n      ! the computation of the velocities to use the hydraulic conductivity estimate\n      ! put into the Poisson solver. In practice this is only important is the hydraulic\n      ! conductivity varies due to the turbulent/modflow scheme.\n      !\n      ! Input Kx is the basic initial hydaulic conductivity\n      ! Input Kxupd is the updated hydraulic conductivity from the previous time step\n      !             used in the Poisson solver\n      ! Output Kxupd is the new updated hydraulic conductivity for the next time step\n      call gw_calculate_velocities(s,par,fracdt,s%gwu,s%gwv,s%gww,Kx,Ky,Kz,Kxupd,Kyupd,Kzupd)", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 409, "line_end": 417, "quote": "      Kxupd = Kx\n      Kzupd = Kz\n      Kyupd = Ky\n      s%Kx = Kx\n      s%Ky = Ky\n      s%Kz = Kz\n      Kx = par%kx\n      Ky = par%ky\n      Kz = par%kz", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1284, "line_end": 1287, "quote": "      real*8,dimension(s%nx+1,s%ny+1),intent(in)  :: fracdt\n      real*8,dimension(s%nx+1,s%ny+1),intent(in)  :: Kx,Ky,Kz\n      real*8,dimension(s%nx+1,s%ny+1),intent(out) :: gwu,gwv,gww\n      real*8,dimension(s%nx+1,s%ny+1),intent(out) :: Kxupd,Kyupd,Kzupd", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1302, "line_end": 1329, "quote": "      ! initialise\n      Kxupd = Kx\n      Kyupd = Ky\n      Kzupd = Kz\n      vcr = par%gwReturb/par%D50(1)*par%por*visc\n      ! Compute of all loops\n      ! u-direction\n      do j=1,s%ny+1\n         do i=1,s%nx+1\n            call gw_calculate_velocities_local(gwu(i,j),Kxupd(i,j),dheaddx(i,j),Kx(i,j),0.d0, &\n            par%gwscheme,.false.,par%wavemodel==WAVEMODEL_NONH,par%gwheadmodel, &\n            s%gwcurv(i,j),s%gwheight(i,j),vcr)\n         enddo\n      enddo\n      ! v-direction\n      do j=1,s%ny+1\n         do i=1,s%nx+1\n            call gw_calculate_velocities_local(gwv(i,j),Kyupd(i,j),dheaddy(i,j),Ky(i,j),0.d0, &\n            par%gwscheme,.false.,par%wavemodel==WAVEMODEL_NONH,par%gwheadmodel, &\n            s%gwcurv(i,j),s%gwheight(i,j),vcr)\n         enddo\n      enddo\n      ! w-direction\n      do j=1,s%ny+1\n         do i=1,s%nx+1\n            call gw_calculate_velocities_local(gww(i,j),Kzupd(i,j),0.d0,Kz(i,j),fracdt(i,j), &\n            par%gwscheme,.true.,par%wavemodel==WAVEMODEL_NONH,par%gwheadmodel, &\n            s%gwcurv(i,j),s%gwheight(i,j),vcr)", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1429, "line_end": 1434, "quote": "            if (isnonh) then\n               vel = -Kin*headgrad ! result bound by pressure solver estimate, will\n               ! update next time step with better K approximation\n            else\n               vel = -Kupd*headgrad\n            endif", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "The cell height at the center of the groundwater cells (ΔzH,i,j)", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96825}, "quote_method": "Concatenated w:t paragraph text, located by XML ordinal."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "q_gw,i,j^x=-K_u,i,j Δz_u,i,j (H_i+1,j-H_i,j)/Δx_u,i,j=-K_u,i,j Δz_u,i,j (H_bc,i+1,j-H_bc,i,j)/Δx_u,i,j", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97215}, "quote_method": "AI visual transcription of the saved render; inline equation glyphs are absent from w:t.", "visual_evidence": {"path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "sha256": "2cf872157095288f986c04015ea7ff6c8f7e22f9e313ddea9023ead0de61a434"}}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "q_gw,i,j^y=-K_v,i,j Δz_v,i,j (H_i+1,j-H_i,j)/Δy_v,i,j=-K_v,i,j Δz_v,i,j (H_bc,i+1,j-H_bc,i,j)/Δy_v,i,j", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97215}, "quote_method": "AI visual transcription of the saved render; inline equation glyphs are absent from w:t.", "visual_evidence": {"path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "sha256": "2cf872157095288f986c04015ea7ff6c8f7e22f9e313ddea9023ead0de61a434"}}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "Δz_u,i,j={Δz_H,i+1,j if q_gw,i,j^x<0; Δz_H,i,j if q_gw,i,j^x≥0}", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96862}, "quote_method": "AI visual transcription of the saved render; inline equation glyphs are absent from w:t.", "visual_evidence": {"path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "sha256": "2cf872157095288f986c04015ea7ff6c8f7e22f9e313ddea9023ead0de61a434"}}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "Δz_v,i,j={Δz_H,i+1,j if q_gw,i,j^y<0; Δz_H,i,j if q_gw,i,j^y≥0}", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96862}, "quote_method": "AI visual transcription of the saved render; inline equation glyphs are absent from w:t.", "visual_evidence": {"path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "sha256": "2cf872157095288f986c04015ea7ff6c8f7e22f9e313ddea9023ead0de61a434"}}], "closure_status": "unresolved", "note": "For GWHEADMODEL_PARABOLIC, H=hbc-(2/3)*gwcurv*gwheight² exactly supplies the written expanded x-gradient. Horizontal velocity then uses -Kin*headgrad, multiplied by interface heights. Differences: Written y-gradient repeats the i+1,j neighbor, while code uses i,j+1. An exponential head option uses sinh/cosh expressions instead of the parabolic expansion. gwnonh selects the groundwater pressure path (:373-382). gw_solver receives Kxupd/Kyupd/Kzupd (:382); gw_calculate_velocities receives separate Kx/Ky/Kz inputs (:397), reset to par%kx/par%ky/par%kz after each step (:415-417). Inside that routine Kxupd/Kyupd/Kzupd are intent(out) (:1287) and are overwritten with Kx/Ky/Kz (:1303-1305). Its Kin arguments are Kx/Ky/Kz (:1311-1329), not the conductivity supplied to the solver. isnonh is supplied by par%wavemodel==WAVEMODEL_NONH, independently of gwnonh. Laminar horizontal velocity uses Kin; turbulent horizontal velocity uses Kin in that surface-wave nonhydrostatic mode and otherwise its locally recomputed Kupd (:1429-1433). Interface heights and dry-cell caps modify the fluxes. Open: B.21/B.23 define the Δz/q_gw symbols; the y-neighbor discrepancy remains unresolved. Definition locators refer only to explicit naming/defining clauses; no defining meaning is inferred from introductory prose. Unbound exact notation uses undefined_in_document. Groundwater physical η and η_gw definitions are cited; any ζ, δ/d, H_gw/H or q pressure/flux variants remain distinct as recorded. Association object top-level member is null as in the packet adapter shape; the actual original member, relationship, locator, preview hashes and OLE hash are preserved in the nested object. S1 correction: q_gw^x, q_gw^y, Δz_u, Δz_v now link to explicit defining clauses/equations; formerly claimed missing definitions for these symbols are withdrawn. Remaining gaps concern the literal variants listed under search_scope.symbol_definitions and the stated model/implementation issues. S3: gwnonh selects the groundwater pressure path (:373-382). gw_solver receives Kxupd/Kyupd/Kzupd (:382); gw_calculate_velocities receives separate Kx/Ky/Kz inputs (:397), reset to par%kx/par%ky/par%kz after each step (:415-417). Inside that routine Kxupd/Kyupd/Kzupd are intent(out) (:1287) and are overwritten with Kx/Ky/Kz (:1303-1305). Its Kin arguments are Kx/Ky/Kz (:1311-1329), not the conductivity supplied to the solver. isnonh is supplied by par%wavemodel==WAVEMODEL_NONH, independently of gwnonh. Laminar horizontal velocity uses Kin; turbulent horizontal velocity uses Kin in that surface-wave nonhydrostatic mode and otherwise its locally recomputed Kupd (:1429-1433). Comment/code mismatch: groundwater.F90:387-396 claims velocity uses the Poisson-solver conductivity estimate. The actual call at :397 supplies base Kx/Ky/Kz as Kin, while :1287 declares updated arrays intent(out) and :1303-1305 overwrites them; therefore the incoming pressure-solver Kxupd/Kyupd/Kzupd estimate does not determine the velocity conductivity. The comments at :370 and :1430 make the same unsupported claim. Which conductivity best serves the intended coupled method and its conservation consequences are not resolved here.", "differences": ["Written y-gradient repeats the i+1,j neighbor, while code uses i,j+1.", "An exponential head option uses sinh/cosh expressions instead of the parabolic expansion.", "gwnonh selects the groundwater pressure path (:373-382). gw_solver receives Kxupd/Kyupd/Kzupd (:382); gw_calculate_velocities receives separate Kx/Ky/Kz inputs (:397), reset to par%kx/par%ky/par%kz after each step (:415-417). Inside that routine Kxupd/Kyupd/Kzupd are intent(out) (:1287) and are overwritten with Kx/Ky/Kz (:1303-1305). Its Kin arguments are Kx/Ky/Kz (:1311-1329), not the conductivity supplied to the solver. isnonh is supplied by par%wavemodel==WAVEMODEL_NONH, independently of gwnonh. Laminar horizontal velocity uses Kin; turbulent horizontal velocity uses Kin in that surface-wave nonhydrostatic mode and otherwise its locally recomputed Kupd (:1429-1433). Interface heights and dry-cell caps modify the fluxes.", "Comment/code mismatch: groundwater.F90:387-396 claims velocity uses the Poisson-solver conductivity estimate. The actual call at :397 supplies base Kx/Ky/Kz as Kin, while :1287 declares updated arrays intent(out) and :1303-1305 overwrites them; therefore the incoming pressure-solver Kxupd/Kyupd/Kzupd estimate does not determine the velocity conductivity. The comments at :370 and :1430 make the same unsupported claim. Which conductivity best serves the intended coupled method and its conservation consequences are not resolved here."], "search_scope": {"root": "models/XBeach/raw/source_code/trunk/src/**", "method": "rg scoped symbol/formula searches, then line reads of flow_timestep.F90, groundwater.F90, morphevolution.F90, libxbeach.F90, spaceparams.F90 and only the directly called Thomas/SIP solver routines; no dependency-internal investigation.", "symbol_definitions": {"document": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "method": "Read/search all w:t paragraphs and all table rows in this document, including output/parameter tables; inspect existing caption images and relevant defining equation images. No Native/MathType decoding. Compare literal notation and distinguish equation assignments from derivation/update prose.", "previously_undefined_rechecked": ["q_gw^x", "q_gw^y", "Δz_u", "Δz_v", "Δx_u", "Δy_v"], "new_definitions": ["q_gw^x", "q_gw^y", "Δz_u", "Δz_v"], "retained_undefined": ["Δx_u", "Δy_v"], "definition_images_inspected": ["_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-035.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-127.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-128.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-129.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-130.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-131.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-133.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-134.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-135.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-136.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-137.png"]}}}
{"id": "kingsday:xml:103051", "association": {"status": "unique", "objects": [{"kind": "ole", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "xml_ordinal": 103039, "paragraph_xml_ordinal": 103023}, "relationship": {"id": "rId453", "target": "embeddings/oleObject209.bin", "type": "http://schemas.openxmlformats.org/officeDocument/2006/relationships/oleObject", "member": "word/embeddings/oleObject209.bin"}, "ole": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx!word/embeddings/oleObject209.bin", "storage": "zip-member", "container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/embeddings/oleObject209.bin", "sha256": "ca3c2835efc42cca7001209fcc0b4621fcca9b52360f1379961d28b26c2d5207"}, "prog_id": "Equation.DSMT4", "shape_id": "_x0000_i1233", "object_id": "_1508071337", "previews": [{"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx!word/media/image231.wmf", "storage": "zip-member", "container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/media/image231.wmf", "sha256": "25490580e9eb4bae5b9e4aaa75ff4491e8d380970e83809aea4ac690d0c1ec60", "relationship": {"id": "rId452", "target": "media/image231.wmf", "type": "http://schemas.openxmlformats.org/officeDocument/2006/relationships/image", "member": "word/media/image231.wmf"}, "xml_ordinal": 103038}], "preview_binding_status": "unique", "member": null}], "page": 142}, "body_status": "readable", "equation_content": {"images_used": [{"path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-142.png", "region": "Equation body aligned with caption (B.57), physical render page 142; surrounding prose used only where specified", "sha256": "1fae8aae72c0e693d574bfb982925dbbc9ee3e5aa479f612e5dd8d5c091e87f6"}, {"path": "_