Beach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "definition_basis": "printed defining equation or symbol-bearing clause"}, "definition_quote": "Δz_u,i,j={Δz_H,i+1,j if q_gw,i,j^x<0; Δz_H,i,j if q_gw,i,j^x≥0}", "meaning": "upwind groundwater cell height at the u interface, defined by B.21"}, {"symbol": "Δz_v", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96862, "render_image": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "definition_basis": "printed defining equation or symbol-bearing clause"}, "definition_quote": "Δz_v,i,j={Δz_H,i+1,j if q_gw,i,j^y<0; Δz_H,i,j if q_gw,i,j^y≥0}", "meaning": "upwind groundwater cell height at the v interface, defined by B.21; the printed i+1,j on the y-flow branch is retained"}, {"symbol": "H", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 24669}, "definition_quote": "H is the hydraulic head", "meaning": "hydraulic head; paragraph 25494 further names the mean vertical groundwater head"}, {"symbol": "H_bc", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96947}, "definition_quote": "the head applied on the top boundary of the groundwater domain (Hbc)", "meaning": "groundwater top-boundary hydraulic head"}, {"symbol": "Δx_u", "definition_locator": null, "definition_quote": null, "meaning": "undefined_in_document"}, {"symbol": "Δy_v", "definition_locator": null, "definition_quote": null, "meaning": "undefined_in_document"}, {"symbol": "i,j", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 94025}, "definition_quote": "The indices i,j refer to the grid number in u resp. v direction", "meaning": "flow/sediment grid indices in u and v directions"}, {"symbol": "u,v", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97300}, "definition_quote": "the subscripts u and v refer to variables approximated at the horizontal cell interfaces in the cross-shore and longshore direction, respectively", "meaning": "cross-shore and longshore face locations"}, {"symbol": "x,y", "definition_locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97300}, "definition_quote": "the superscripts x and y refer to the components of the variable in the cross-shore and longshore direction, respectively", "meaning": "cross-shore and longshore components"}], "evidence": [{"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 375, "line_end": 378, "quote": "         ! stability\n         !     factime = min(par%dt/0.2d0,1.d0)\n         !     gwhead = (1.d0-factime)*gwhead + factime*gwheadtop\n         s%gwhead = (s%gwhead + gwheadtop)/2", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 775, "line_end": 782, "quote": "            dheaddx(i,j)=(gwhead(i+1,j)-gwhead(i,j))/dsu(i,j)\n         end do\n      end do\n\n      do j=1,ny\n         do i=1,nx+1\n            dheaddy(i,j)=(gwhead(i,j+1)-gwhead(i,j))/dnv(i,j)\n         end do", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1311, "line_end": 1322, "quote": "            call gw_calculate_velocities_local(gwu(i,j),Kxupd(i,j),dheaddx(i,j),Kx(i,j),0.d0, &\n            par%gwscheme,.false.,par%wavemodel==WAVEMODEL_NONH,par%gwheadmodel, &\n            s%gwcurv(i,j),s%gwheight(i,j),vcr)\n         enddo\n      enddo\n      ! v-direction\n      do j=1,s%ny+1\n         do i=1,s%nx+1\n            call gw_calculate_velocities_local(gwv(i,j),Kyupd(i,j),dheaddy(i,j),Ky(i,j),0.d0, &\n            par%gwscheme,.false.,par%wavemodel==WAVEMODEL_NONH,par%gwheadmodel, &\n            s%gwcurv(i,j),s%gwheight(i,j),vcr)\n         enddo", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1360, "line_end": 1369, "quote": "         else       ! horizontal flow\n            vel = -Kin*headgrad\n         endif\n         Kupd = Kin\n       case (GWSCHEME_TURBULENT)\n         if (isvert .and. isnonh) then  ! vertical flow non-hydrostatic\n            select case(headmodel)\n             case (GWHEADMODEL_PARABOLIC)\n               vest = -Kin*2*gwc*gwh\n               if (abs(vest)>vcr) then", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1426, "line_end": 1434, "quote": "            else\n               Kupd = Kin\n            endif\n            if (isnonh) then\n               vel = -Kin*headgrad ! result bound by pressure solver estimate, will\n               ! update next time step with better K approximation\n            else\n               vel = -Kupd*headgrad\n            endif", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 426, "line_end": 442, "quote": "      ! Stop cells from drying up\n      if (s%ny>0) then\n         do i=2,s%nx\n            do j=2,s%ny\n               if (s%gwlevel(i,j)<=s%gwbottom(i,j)+par%eps) then\n                  s%gwqx(i,j) = min(s%gwqx(i,j),0.d0) ! let no water out, only in\n                  s%gwqx(i-1,j) = max(s%gwqx(i-1,j),0.d0) ! let no water out, only in\n                  s%gwqy(i,j) = min(s%gwqy(i,j),0.d0) ! let no water out, only in\n                  s%gwqy(i,j-1) = max(s%gwqy(i,j-1),0.d0) ! let no water out, only in\n               endif\n            enddo\n         enddo\n      else\n         do i=2,s%nx\n            if (s%gwlevel(i,1)<=s%gwbottom(i,1)+par%eps) then\n               s%gwqx(i,1) = min(s%gwqx(i,1),0.d0) ! let no water out, only in\n               s%gwqx(i-1,1) = max(s%gwqx(i-1,1),0.d0) ! let no water out, only in", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "H is the hydraulic head", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 24669}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "the head applied on the top boundary of the groundwater domain (Hbc)", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96947}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "The indices i,j refer to the grid number in u resp. v direction", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 94025}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "the superscripts x and y refer to the components of the variable in the cross-shore and longshore direction, respectively", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97300}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "In  the parameter κr is the relative numerical ‘connectedness’ of the groundwater and surface water head, determined by linear interpolation across the numerical smoothing constant ε.", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97112}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "In the case of hydrostatic groundwater flow, the groundwater head in each cell is set equal to the head applied on the top boundary of the groundwater domain (Hbc) and the horizontal groundwater flux is computed from the groundwater head gradient:", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97186}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "In the case of non-hydrostatic groundwater flow, the horizontal specific discharge on each cell interface can be found through an approximation of the non-hydrostatic groundwater head gradient:", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97398}, "quote_method": "Concatenated w:t paragraph text on word/document.xml line 2; exact paragraph identified by XML ordinal. Inline OLE and field bodies are not decoded."}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 373, "line_end": 397, "quote": "      if (par%gwnonh == 0) then\n         ! hydrostatic pressure assumption, with time delay required for\n         ! stability\n         !     factime = min(par%dt/0.2d0,1.d0)\n         !     gwhead = (1.d0-factime)*gwhead + factime*gwheadtop\n         s%gwhead = (s%gwhead + gwheadtop)/2\n      else\n         ! non-hydrostatic pressure, solve using Poisson solver. Kxupd is the\n         ! updated hydraulic conductivity from the previous time step\n         call gw_solver(par,s,gwheadtop,Kxupd,Kyupd,Kzupd,gwhu,gwhv,fracdt)\n      endif\n      !\n      !\n      ! Calculate groundwater velocities\n      ! We use Kxupd input which is the same value as sent into the Poisson solver in\n      ! the previous command. In the case of the non-hydrostatic solver, we must force\n      ! the computation of the velocities to use the hydraulic conductivity estimate\n      ! put into the Poisson solver. In practice this is only important is the hydraulic\n      ! conductivity varies due to the turbulent/modflow scheme.\n      !\n      ! Input Kx is the basic initial hydaulic conductivity\n      ! Input Kxupd is the updated hydraulic conductivity from the previous time step\n      !             used in the Poisson solver\n      ! Output Kxupd is the new updated hydraulic conductivity for the next time step\n      call gw_calculate_velocities(s,par,fracdt,s%gwu,s%gwv,s%gww,Kx,Ky,Kz,Kxupd,Kyupd,Kzupd)", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 409, "line_end": 417, "quote": "      Kxupd = Kx\n      Kzupd = Kz\n      Kyupd = Ky\n      s%Kx = Kx\n      s%Ky = Ky\n      s%Kz = Kz\n      Kx = par%kx\n      Ky = par%ky\n      Kz = par%kz", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1284, "line_end": 1287, "quote": "      real*8,dimension(s%nx+1,s%ny+1),intent(in)  :: fracdt\n      real*8,dimension(s%nx+1,s%ny+1),intent(in)  :: Kx,Ky,Kz\n      real*8,dimension(s%nx+1,s%ny+1),intent(out) :: gwu,gwv,gww\n      real*8,dimension(s%nx+1,s%ny+1),intent(out) :: Kxupd,Kyupd,Kzupd", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1302, "line_end": 1329, "quote": "      ! initialise\n      Kxupd = Kx\n      Kyupd = Ky\n      Kzupd = Kz\n      vcr = par%gwReturb/par%D50(1)*par%por*visc\n      ! Compute of all loops\n      ! u-direction\n      do j=1,s%ny+1\n         do i=1,s%nx+1\n            call gw_calculate_velocities_local(gwu(i,j),Kxupd(i,j),dheaddx(i,j),Kx(i,j),0.d0, &\n            par%gwscheme,.false.,par%wavemodel==WAVEMODEL_NONH,par%gwheadmodel, &\n            s%gwcurv(i,j),s%gwheight(i,j),vcr)\n         enddo\n      enddo\n      ! v-direction\n      do j=1,s%ny+1\n         do i=1,s%nx+1\n            call gw_calculate_velocities_local(gwv(i,j),Kyupd(i,j),dheaddy(i,j),Ky(i,j),0.d0, &\n            par%gwscheme,.false.,par%wavemodel==WAVEMODEL_NONH,par%gwheadmodel, &\n            s%gwcurv(i,j),s%gwheight(i,j),vcr)\n         enddo\n      enddo\n      ! w-direction\n      do j=1,s%ny+1\n         do i=1,s%nx+1\n            call gw_calculate_velocities_local(gww(i,j),Kzupd(i,j),0.d0,Kz(i,j),fracdt(i,j), &\n            par%gwscheme,.true.,par%wavemodel==WAVEMODEL_NONH,par%gwheadmodel, &\n            s%gwcurv(i,j),s%gwheight(i,j),vcr)", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "source_code", "path": "models/XBeach/raw/source_code/trunk/src/xbeachlibrary/groundwater.F90", "line_start": 1429, "line_end": 1434, "quote": "            if (isnonh) then\n               vel = -Kin*headgrad ! result bound by pressure solver estimate, will\n               ! update next time step with better K approximation\n            else\n               vel = -Kupd*headgrad\n            endif", "sha256": "e941accf34fb9b4f21256dcb59b986ad2df2976a8bc151af926e3ce38c8cf494"}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "q_gw,i,j^x=-K_u,i,j Δz_u,i,j (H_i+1,j-H_i,j)/Δx_u,i,j=-K_u,i,j Δz_u,i,j (H_bc,i+1,j-H_bc,i,j)/Δx_u,i,j", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97215}, "quote_method": "AI visual transcription of the saved render; inline equation glyphs are absent from w:t.", "visual_evidence": {"path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "sha256": "2cf872157095288f986c04015ea7ff6c8f7e22f9e313ddea9023ead0de61a434"}}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "q_gw,i,j^y=-K_v,i,j Δz_v,i,j (H_i+1,j-H_i,j)/Δy_v,i,j=-K_v,i,j Δz_v,i,j (H_bc,i+1,j-H_bc,i,j)/Δy_v,i,j", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 97215}, "quote_method": "AI visual transcription of the saved render; inline equation glyphs are absent from w:t.", "visual_evidence": {"path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "sha256": "2cf872157095288f986c04015ea7ff6c8f7e22f9e313ddea9023ead0de61a434"}}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "Δz_u,i,j={Δz_H,i+1,j if q_gw,i,j^x<0; Δz_H,i,j if q_gw,i,j^x≥0}", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96862}, "quote_method": "AI visual transcription of the saved render; inline equation glyphs are absent from w:t.", "visual_evidence": {"path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "sha256": "2cf872157095288f986c04015ea7ff6c8f7e22f9e313ddea9023ead0de61a434"}}, {"role": "document_text", "path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "line_start": 2, "line_end": 2, "quote": "Δz_v,i,j={Δz_H,i+1,j if q_gw,i,j^y<0; Δz_H,i,j if q_gw,i,j^y≥0}", "sha256": "c78396a23cec17b13be94ab1deef921c89b3d0c6a3d1f7d05e7d741e432c6543", "locator": {"container_path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_xml_ordinal": 96862}, "quote_method": "AI visual transcription of the saved render; inline equation glyphs are absent from w:t.", "visual_evidence": {"path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-132.png", "sha256": "2cf872157095288f986c04015ea7ff6c8f7e22f9e313ddea9023ead0de61a434"}}], "closure_status": "unresolved", "note": "Darcy horizontal velocities use -K*headgrad and face fluxes multiply by gwhu/gwhv. Gradient spacings are dsu/dnv. Differences: The y line of the image uses i+1,j in both head differences; code uses i,j+1. Hydrostatic head is averaged with the preceding head rather than set exactly to H_bc. gwnonh selects the groundwater pressure path (:373-382). gw_solver receives Kxupd/Kyupd/Kzupd (:382); gw_calculate_velocities receives separate Kx/Ky/Kz inputs (:397), reset to par%kx/par%ky/par%kz after each step (:415-417). Inside that routine Kxupd/Kyupd/Kzupd are intent(out) (:1287) and are overwritten with Kx/Ky/Kz (:1303-1305). Its Kin arguments are Kx/Ky/Kz (:1311-1329), not the conductivity supplied to the solver. isnonh is supplied by par%wavemodel==WAVEMODEL_NONH, independently of gwnonh. Laminar horizontal velocity uses Kin; turbulent horizontal velocity uses Kin in that surface-wave nonhydrostatic mode and otherwise its locally recomputed Kupd (:1429-1433). Interface heights and dry-cell caps modify the fluxes. Open: B.23 defines q_gw^x/y and B.21 defines the Δz interface heights. The printed y-neighbor discrepancy remains unresolved. Definition locators refer only to explicit naming/defining clauses; no defining meaning is inferred from introductory prose. Unbound exact notation uses undefined_in_document. Groundwater physical η and η_gw definitions are cited; any ζ, δ/d, H_gw/H or q pressure/flux variants remain distinct as recorded. Association object top-level member is null as in the packet adapter shape; the actual original member, relationship, locator, preview hashes and OLE hash are preserved in the nested object. S1 correction: q_gw^x, q_gw^y, Δz_u, Δz_v now link to explicit defining clauses/equations; formerly claimed missing definitions for these symbols are withdrawn. Remaining gaps concern the literal variants listed under search_scope.symbol_definitions and the stated model/implementation issues. S3: gwnonh selects the groundwater pressure path (:373-382). gw_solver receives Kxupd/Kyupd/Kzupd (:382); gw_calculate_velocities receives separate Kx/Ky/Kz inputs (:397), reset to par%kx/par%ky/par%kz after each step (:415-417). Inside that routine Kxupd/Kyupd/Kzupd are intent(out) (:1287) and are overwritten with Kx/Ky/Kz (:1303-1305). Its Kin arguments are Kx/Ky/Kz (:1311-1329), not the conductivity supplied to the solver. isnonh is supplied by par%wavemodel==WAVEMODEL_NONH, independently of gwnonh. Laminar horizontal velocity uses Kin; turbulent horizontal velocity uses Kin in that surface-wave nonhydrostatic mode and otherwise its locally recomputed Kupd (:1429-1433). Comment/code mismatch: groundwater.F90:387-396 claims velocity uses the Poisson-solver conductivity estimate. The actual call at :397 supplies base Kx/Ky/Kz as Kin, while :1287 declares updated arrays intent(out) and :1303-1305 overwrites them; therefore the incoming pressure-solver Kxupd/Kyupd/Kzupd estimate does not determine the velocity conductivity. The comments at :370 and :1430 make the same unsupported claim. Which conductivity best serves the intended coupled method and its conservation consequences are not resolved here.", "differences": ["The y line of the image uses i+1,j in both head differences; code uses i,j+1.", "Hydrostatic head is averaged with the preceding head rather than set exactly to H_bc.", "gwnonh selects the groundwater pressure path (:373-382). gw_solver receives Kxupd/Kyupd/Kzupd (:382); gw_calculate_velocities receives separate Kx/Ky/Kz inputs (:397), reset to par%kx/par%ky/par%kz after each step (:415-417). Inside that routine Kxupd/Kyupd/Kzupd are intent(out) (:1287) and are overwritten with Kx/Ky/Kz (:1303-1305). Its Kin arguments are Kx/Ky/Kz (:1311-1329), not the conductivity supplied to the solver. isnonh is supplied by par%wavemodel==WAVEMODEL_NONH, independently of gwnonh. Laminar horizontal velocity uses Kin; turbulent horizontal velocity uses Kin in that surface-wave nonhydrostatic mode and otherwise its locally recomputed Kupd (:1429-1433). Interface heights and dry-cell caps modify the fluxes.", "Comment/code mismatch: groundwater.F90:387-396 claims velocity uses the Poisson-solver conductivity estimate. The actual call at :397 supplies base Kx/Ky/Kz as Kin, while :1287 declares updated arrays intent(out) and :1303-1305 overwrites them; therefore the incoming pressure-solver Kxupd/Kyupd/Kzupd estimate does not determine the velocity conductivity. The comments at :370 and :1430 make the same unsupported claim. Which conductivity best serves the intended coupled method and its conservation consequences are not resolved here."], "search_scope": {"root": "models/XBeach/raw/source_code/trunk/src/**", "method": "rg scoped symbol/formula searches, then line reads of flow_timestep.F90, groundwater.F90, morphevolution.F90, libxbeach.F90, spaceparams.F90 and only the directly called Thomas/SIP solver routines; no dependency-internal investigation.", "symbol_definitions": {"document": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "method": "Read/search all w:t paragraphs and all table rows in this document, including output/parameter tables; inspect existing caption images and relevant defining equation images. No Native/MathType decoding. Compare literal notation and distinguish equation assignments from derivation/update prose.", "previously_undefined_rechecked": ["q_gw^x", "q_gw^y", "Δz_u", "Δz_v", "Δx_u", "Δy_v"], "new_definitions": ["q_gw^x", "q_gw^y", "Δz_u", "Δz_v"], "retained_undefined": ["Δx_u", "Δy_v"], "definition_images_inspected": ["_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-035.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-127.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-128.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-129.png", "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-