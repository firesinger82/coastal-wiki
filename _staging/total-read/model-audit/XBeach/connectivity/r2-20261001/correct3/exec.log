symbols [{"symbol": "W̄", "definition_locator": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_start_xml_ordinal": 104051}, "definition_quote": "The pressures are defined on the cell faces and therefore do not have to be interpolated. Furthermore, we can exactly set the dynamic pressure at the free surface  to zero. The vertical velocities are defined on the cell faces and therefore the depth averaged velocity  needs to be expressed in terms of the bottom and surface velocities. Using a simple central approximation gives", "meaning": "depth averaged vertical velocity; capital bare W is not explicitly defined here"}, {"symbol": "ΔW̄", "definition_locator": null, "definition_quote": null, "meaning": "undefined_in_document", "context_basis": {"meaning": "face slope-limited W̄ increments by analogy with B.61", "reference": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_start_xml_ordinal": 104738}, "quote": "Where  and  are obtained using relations similar to . Note that similar to  and again the kinematic boundary conditions is substituted for .", "limit": "This reference does not print a complete explicit definition."}, "context_locator": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_start_xml_ordinal": 104738}, "definition_search": {"document": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "scope": "all paragraph w:t including symbol/output tables, coordinate definitions and the opened local equations/inline formulas", "result": "No explicit occurrence-appropriate definition of this exact printed symbol located; context/source meanings and spelling variants are separated."}}, {"symbol": "H", "definition_locator": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_start_xml_ordinal": 100959}, "definition_quote": "In which U is the depth averaged velocity vector in x, V in y, H the water depth. A simple semi-discretization of  using central differences for the space derivative and using the Hansen scheme for the coupling between velocity and free surface results in:", "meaning": "water depth"}, {"symbol": "q^x", "definition_locator": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_start_xml_ordinal": 101135}, "definition_quote": "With ^x q^*_{i+1/2,j}=H^n_{i+1/2,j}U^{n+1/2}_{i+1/2,j}", "meaning": "x depth-integrated discharge defined by H U"}, {"symbol": "q^y", "definition_locator": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_start_xml_ordinal": 101135}, "definition_quote": "^y q^*_{i,j+1/2}=H^n_{i,j+1/2}V^{n+1/2}_{i,j+1/2}", "meaning": "y depth-integrated discharge defined by H V"}, {"symbol": "Δp", "definition_locator": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_start_xml_ordinal": 102443}, "definition_quote": "p^{n+1½}_{i,j}=p^{n+1/2}_{i,j}+Δp^{n+1½}_{i,j}", "meaning": "pressure increment in the explicit pressure decomposition (B.55); normalization not supplied by this definition", "context_basis": {"method": "opened render image", "path": "_staging/total-read/model-audit/XBeach/connectivity/manuals-docx-read/full-visual-read/kingsday/page-141.png", "sha256": "91548b300fd626cef484ce1cfb809b78cb56371c3b44830981f2a2fe73377437", "paragraph": 102443}}, {"symbol": "Δt", "definition_locator": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_start_xml_ordinal": 95916}, "definition_quote": "In  the pressure term plpf  is the surface water pressure at the bed, which in the case of non-hydrostatic surface water flow is high-pass filtered at 4/Trep, the superscript n corresponds to the time step number and Δt is the size of the time step. The infiltration rate in the coupled relationship can be solved through substitution:", "meaning": "size of time step"}, {"symbol": "Δx", "definition_locator": null, "definition_quote": null, "meaning": "undefined_in_document", "context_basis": {"meaning": "x grid spacing in the printed finite differences", "limit": "Standard/source-supported role, not a located explicit definition for this exact printed symbol."}, "definition_search": {"document": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "scope": "all paragraph w:t including symbol/output tables, coordinate definitions and the opened local equations/inline formulas", "result": "No explicit occurrence-appropriate definition of this exact printed symbol located; context/source meanings and spelling variants are separated."}}, {"symbol": "Δy", "definition_locator": null, "definition_quote": null, "meaning": "undefined_in_document", "context_basis": {"meaning": "y grid spacing in the printed finite differences", "limit": "Standard/source-supported role, not a located explicit definition for this exact printed symbol."}, "definition_search": {"document": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "scope": "all paragraph w:t including symbol/output tables, coordinate definitions and the opened local equations/inline formulas", "result": "No explicit occurrence-appropriate definition of this exact printed symbol located; context/source meanings and spelling variants are separated."}}, {"symbol": "n", "definition_locator": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_start_xml_ordinal": 94025}, "definition_quote": "Here, Acell is the area of the cell around the cell center, zs is the surface elevation, uu is the u-velocity in the u-point, hu the water depth in the u-point and vv the v-velocity in the v-point. The indices i,j refer to the grid number in u resp. v direction; the index n refers to the time step.", "meaning": "time step index in discretized equations; not the group velocity ratio output variable"}, {"symbol": "i,j", "definition_locator": {"path": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "paragraph_start_xml_ordinal": 94025}, "definition_quote": "Here, Acell is the area of the cell around the cell center, zs is the surface elevation, uu is the u-velocity in the u-point, hu the water depth in the u-point and vv the v-velocity in the v-point. The indices i,j refer to the grid number in u resp. v direction; the index n refers to the time step.", "meaning": "grid number in u and v directions; (B.43) uses bed-layer/sediment-class indices instead"}, {"symbol": "*", "definition_locator": null, "definition_quote": null, "meaning": "undefined_in_document", "context_basis": {"meaning": "predicted/intermediate-state label in this local scheme", "limit": "Standard/source-supported role, not a located explicit definition for this exact printed symbol."}, "definition_search": {"document": "models/XBeach/raw/source_code/trunk/doc/manual/XBeach_manual_kingsday.docx", "member": "word/document.xml", "scope": "all paragraph w:t including symbol/output tables, coordinate definitions and the opened local equations/inline formulas", "result": "No explicit occurrence-appropriate definition of this exact printed symbol located; context/source meanings and spelling variants are separated."}}]
