procs={r['id']:r for r in map(json.loads,(C/'runtime-20260912/procedures.jsonl').read_text().splitlines())}
_lines={}
def lines(p):
 p=str(p)
 if p not in _lines:_lines[p]=(ROOT/p).read_text(errors='replace').splitlines()
 return _lines[p]
def short(r): return {k:v for k,v in r.items() if k not in ('bindings','evidence')}
def ev(path,a,b=None,role='runtime_control'):
 p=str(path); b=a if b is None else b
