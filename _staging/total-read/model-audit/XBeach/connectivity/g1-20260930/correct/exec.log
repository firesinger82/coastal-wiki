11:    integer(c_int) pure function strlen(char_array)
12:       character(c_char), intent(in) :: char_array(MAXSTRINGLEN)
13:       integer :: i
14:       strlen = 0
15:       do i = 1, size(char_array)
16:          if (char_array(i) .eq. C_NULL_CHAR) then
17:             strlen = i-1
18:             exit
19:          end if
20:       end do
21:    end function strlen
22: 
23:    integer(c_int) pure function strcmp(char_array1, char_array2)
24:       character(c_char), intent(in) :: char_array1(MAXSTRINGLEN)
25:       character(c_char), intent(in) :: char_array2(MAXSTRINGLEN)
26: 
27:       character(len=strlen(char_array1)) :: string1
28:       character(len=strlen(char_array2)) :: string2
29: 
30:       string1 = trim(char_array_to_string(char_array1))
31:       string2 = trim(char_array_to_string(char_array1))
32:       strcmp = 0
33:       if (llt(string1,string2)) strcmp = -1
34:       if (lgt(string1,string2)) strcmp = 1
35: 
36:    end function strcmp
37: 
38: 
