40:    subroutine strcpy(str1, str2)
41:       character(c_char), intent(in) :: str1(MAXSTRINGLEN)
42:       character(c_char), intent(out) :: str2(MAXSTRINGLEN)
43: 
44:       integer :: i
45:       str2 = ' '
46:       do i=1,(strlen(str1) + 1)
47:          str2(i) = str1(i)
48:       end do
49:    end subroutine strcpy
50: 
51:    pure function char_array_to_string(char_array) result(string)
52:       character(c_char),intent(in) :: char_array(MAXSTRINGLEN)
53:       character(len=strlen(char_array)) :: string
54:       integer :: i
55:       do i = 1, strlen(char_array)
56:          string(i:i) = char_array(i)
57:       enddo
58:    end function char_array_to_string
59: 
60:    pure function string_to_char_array(string) result(char_array)
61:       character(len=*), intent(in) :: string
62:       character(kind=c_char,len=1) :: char_array(MAXSTRINGLEN)
63:       integer :: i
64:       do i = 1, len_trim(string)
65:          char_array(i) = string(i:i)
66:       enddo
