 for n,l in enumerate(lines(p)[a-1:b],a):print(f'{n}: {l}')

def split_args(s):
 out=[];start=0;depth=0;quote=None;i=0
 while i<len(s):
  ch=s[i]
  if quote:
   if ch==quote:
    if i+1<len(s) and s[i+1]==quote:i+=1
    else:quote=None
  elif ch in \"'\\\"\":quote=ch
  elif ch=='(':depth+=1
  elif ch==')':depth-=1
  elif ch==',' and depth==0:out.append(s[start:i].strip());start=i+1
  i+=1
 out.append(s[start:].strip())
 return out

for r in records:
 c=cands[r['id']]
 if c['symbol']"'!='"'writelog':continue
 for b in r['bindings'][:1]:
