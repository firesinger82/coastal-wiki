  if sel:
   kind=re.sub(r'"'^'"\\s*kind\\s*=\\s*','',sel,flags=re.I).lower().strip()
  else:kind={'integer':'kind(0)','real':'kind(0.0)','logical':'kind(.true.)'}[cat]
