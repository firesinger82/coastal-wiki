 if cat=='type':return ('type',(sel or '').lower())
 if cat=='character':
  if sel and re.search(r'\\bkind\\s*=',sel,re.I):
   kind=re.search(r'\\bkind\\s*=\\s*(["'^,)]+)'"',sel,re.I)[1].strip().lower()
