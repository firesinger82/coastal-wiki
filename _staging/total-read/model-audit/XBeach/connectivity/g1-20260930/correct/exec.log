procs={r['id']:r for r in map(json.loads,(C/'runtime-20260912/procedures.jsonl').read_text().splitlines())}
_lines={}
def lines(p):
 p=str(p)
 if p not in _lines:_lines[p]=(ROOT/p).read_text(errors='replace').splitlines()
 return _lines[p]
def short(r): return {k:v for k,v in r.items() if k not in ('bindings','evidence')}
def ev(path,a,b=None,role='runtime_control'):
 p=str(path); b=a if b is None else b
 assert p in inputs,p
 return {'role':role,'path':p,'line_start':a,'line_end':b,'quote':'\\n'.join(lines(p)[a-1:b]),'sha256':inputs[p]}
def snippet(p,a,b):
 print('\\nSOURCE',str(p)+':'+str(a)+'-'+str(b))
 for n,l in enumerate(lines(p)[a-1:b],a):print(f'{n}: {l}')

for r in records:
 if cands[r['id']]['symbol'] in ['char_array_to_string','chartoindex','getversion','getdoubleparameter','getintparameter','getcharparameter','string_to_char_array','strcmp','strcpy'] or re.search(r'(c_char.{0,100}default|default.{0,100}c_char|c_int.{0,100}default)',r.get('note',''),re.I):
  c=cands[r['id']];p=procs[c['caller']]
  L=lines(p['path'])
  a=[(i,l.strip()) for i,l in enumerate(L[p['line_start']-1:min(p['line_start']+32,p['line_end'])],p['line_start']) if re.search(r'character|integer',l.split('"'!'"')[0],re.I)]
  print(r['id'],'CALL',c['statement'],'TARGET',[b['target'].split(':')[-1] for b in r.get('bindings',[])],'STATUS',[b['applicability']['status'] for b in r.get('bindings',[])],'DECL',a)
print('MPI MIN CONFIRMED',[(r['id'],[b['applicability']['status'] for b in r.get('bindings',[])]) for r in records if 'MPI_MIN' in cands[r['id']]['statement'] and any(b['applicability']['status']=='confirmed' for b in r.get('bindings',[]))])
print('WLOG SUFFIX_COUNTS',collections.Counter(tuple(b['target'].split(':')[-1] for b in r.get('bindings',[])) for r in records if cands[r['id']]['symbol']=='writelog'))

