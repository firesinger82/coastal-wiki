cands={r['id']:r for r in map(json.loads,(C/'runtime-20260912/call-candidates.jsonl').read_text().splitlines())}
procs={r['id']:r for r in map(json.loads,(C/'runtime-20260912/procedures.jsonl').read_text().splitlines())}
_lines={}
def lines(p):
 p=str(p)
 if p not in _lines:_lines[p]=(ROOT/p).read_text(errors='replace').splitlines()
 return _lines[p]
def short(r): return {k:v for k,v in r.items() if k not in ('bindings','evidence')}
def ev(path,a,b=None,role='runtime_control'):
 p=str(path); b=a if b is None else b
 assert p in inputs,p
 return {'role':role,'path':p,'line_start':a,'line_end':b,'quote':'\\n'.join(lines(p)[a-1:b]),'sha256':inputs[p]}
def snippet(p,a,b):
 print('\\nSOURCE',str(p)+':'+str(a)+'-'+str(b))
 for n,l in enumerate(lines(p)[a-1:b],a):print(f'{n}: {l}')

for f,a,b in [('src/xbeachlibrary/ncoutput.F90',99,116),('src/xbeachlibrary/ncoutput.F90',570,640),('src/xbeachlibrary/roelvink.F90',1,10),('src/xbeachlibrary/spaceparams.F90',314,324),('src/xbeachlibrary/spaceparams.F90',376,383),('src/xbeachlibrary/spaceparams.F90',594,602),('src/xbeachlibrary/spaceparams.F90',699,741),('src/xbeachlibrary/spaceparams.F90',1099,1143),('src/xbeachlibrary/xbeachlibrary_IFX.vfproj',152,184),('src/xbeachlibrary/rainfall.F90',19,48)]:
 snippet('models/XBeach/raw/source_code/trunk/'+f,a,b)
for x in buildmap['src_files']:
 if 'test' in x['path'] or x['path'] in {c['id'].split(':')[0] for c in records if '/introspection.' in c['id']}:
  print('BUILD FILE',x)
print('TEST ELIGIBLE',[p for p in inputs if 'test' in p and (p.endswith('vfproj') or p.endswith('Makefile.am'))])

