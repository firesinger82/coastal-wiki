import json, pathlib, collections, re, copy, hashlib
ROOT=pathlib.Path.cwd()
C=ROOT/'_staging/total-read/model-audit/XBeach/connectivity'
G=C/'g1-20260930'
S=ROOT/'models/XBeach/raw/source_code/trunk'
records=[json.loads(l) for l in (G/'G1-all.jsonl').read_text().splitlines()]
byid={r['id']:r for r in records}
verdicts=json.loads((G/'verify/all-verdicts.json').read_text())
bad=[v for v in verdicts if v['verdict']"'!='"'STANDS']
vmap={v['id']:v for v in bad}
buildmap=json.loads((C/'build-mode-20260912/build-map.json').read_text())
inputs=json.loads((G/'inputs.json').read_text())['files']
cands={r['id']:r for r in map(json.loads,(C/'runtime-20260912/call-candidates.jsonl').read_text().splitlines())}
procs={r['id']:r for r in map(json.loads,(C/'runtime-20260912/procedures.jsonl').read_text().splitlines())}
_lines={}
def lines(p):
 p=str(p)
 if p not in _lines:_lines[p]=(ROOT/p).read_text(errors='replace').splitlines()
 return _lines[p]
def short(r): return {k:v for k,v in r.items() if k not in ('bindings','evidence')}
def ev(path,a,b=None,role='runtime_control'):
 p=str(path); b=a if b is None else b
 assert p in inputs,p
 return {'role':role,'path':p,'line_start':a,'line_end':b,'quote':'\\n'.join(lines(p)[a-1:b]),'sha256':inputs[p]}
def snippet(p,a,b):
 print('\\nSOURCE',str(p)+':'+str(a)+'-'+str(b))
 for n,l in enumerate(lines(p)[a-1:b],a):print(f'{n}: {l}')

def uncomment(s):
 q=None;out='';i=0
 while i<len(s):
  ch=s[i]
  if q:
   out+=ch
   if ch==q:
    if i+1<len(s) and s[i+1]==q:out+=s[i+1];i+=1
    else:q=None
  elif ch in \"'\\\"\":q=ch;out+=ch
  elif ch=='"'!'"':break
  else:out+=ch
  i+=1
 return out
def logical_statements(path,a=1,b=None):
 L=lines(path);b=len(L) if b is None else b
 cur='';start=None
 for i in range(a,b+1):
  t=uncomment(L[i-1]).strip()
  if not t:continue
  if t.startswith('#'):
   if cur:yield (start,i-1,cur);cur='';start=None
   yield(i,i,t);continue
  if start is None:start=i
  cur+=((' ' if cur else '')+t.lstrip('&').strip())
  if cur.endswith('&'):cur=cur[:-1].rstrip();continue
  yield(start,i,cur);cur='';start=None
 if cur:yield(start,b,cur)
def paren_contents(t,pos=None):
 pos=t.index('(') if pos is None else pos;depth=0;q=None;i=pos
 while i<len(t):
  ch=t[i]
  if q:
   if ch==q:
    if i+1<len(t) and t[i+1]==q:i+=1
    else:q=None
  elif ch in \"'\\\"\":q=ch
  elif ch=='(':depth+=1
  elif ch==')':
   depth-=1
   if depth==0:return t[pos+1:i],t[i+1:].strip()
  i+=1
 return None,None
def cpp_contexts(path):
 stack=[];out={}
 for a,b,s in logical_statements(path):
  sl=s.lower()
  if sl.startswith('#ifdef '):stack.append({'terms':['defined('+s.split()[1]+')'],'current':'defined('+s.split()[1]+')','a':a})
  elif sl.startswith('#ifndef '):stack.append({'terms':['defined('+s.split()[1]+')'],'current':'.not.defined('+s.split()[1]+')','a':a})
  elif sl.startswith('#if '):stack.append({'terms':[s[4:]],'current':s[4:],'a':a})
  elif sl.startswith('#elif '):
   x=stack[-1];term=s[6:];x['current']='.not.('+ ' .or. '.join(x['terms'])+') .and. ('+term+')';x['terms'].append(term)
  elif sl.startswith('#else'):
   x=stack[-1];x['current']='.not.('+ ' .or. '.join(x['terms'])+')'
  elif sl.startswith('#endif'):
   if stack:stack.pop()
  for n in range(a,b+1):out[n]=[(x['a'],x['current']) for x in stack]
 return out
cpp_tables={p:cpp_contexts(p) for p in {procs[cands[r['id']]['caller']]['path'] for r in records}}
def parse_proc(p):
 stack=[];nodes=[];events=[];loops=[];labels={};issues=[]
 for a,b,s0 in logical_statements(p['path'],p['line_start'],p['line_end']):
  s=s0;label=re.match(r'"'^('"\\d+)\\s+(.*)',s)
  if label:labels[label[1]]=a;s=label[2]
  sl=s.lower()
  if sl.startswith('#'):continue
  if sl=='contains':break
  if re.match(r'end\\s*do\\b',sl):
   if stack and stack[-1]['kind']=='do':stack[-1]['end']=b;stack.pop()
   else:issues.append((a,'enddo'))
   continue
  if re.match(r'end\\s*if\\b',sl):
   if stack and stack[-1]['kind']=='if':stack.pop()
   else:issues.append((a,'endif'))
   continue
  if re.match(r'end\\s*select\\b',sl):
   if stack and stack[-1]['kind']=='select':stack.pop()
   else:issues.append((a,'endselect'))
   continue
  if re.match(r'else\\s*if\\s*\\(',sl):
   cond,rest=paren_contents(s);x=stack[-1]
   x['active']='.not.('+' .or. '.join(x['tests'])+') .and. ('+cond+')'
   x['tests'].append('('+cond+')');x['branch_a']=a;x['branch_b']=b
   continue
  if re.match(r'else\\b',sl):
   if stack and stack[-1]['kind']=='if':
    x=stack[-1];x['active']='.not.('+' .or. '.join(x['tests'])+')';x['branch_a']=a;x['branch_b']=b
   else:issues.append((a,'else'))
   continue
  if re.match(r'case\\s*(\\(|default)',sl):
   if stack and stack[-1]['kind']=='select':
    x=stack[-1];val=None if 'default' in sl else paren_contents(s)[0]
    if val is not None:x['cases'].append(val)
    x['active_case']=val;x['branch_a']=a;x['branch_b']=b
   else:issues.append((a,'case'))
   continue
  guards=[]
  for x in stack:
   if x['kind']=='if':guards.append((x['branch_a'],x['branch_b'],x['active']))
   elif x['kind']=='select':guards.append((x['branch_a'],x['branch_b'],('case',x,x['active_case'])))
  active_loops=[x for x in stack if x['kind']=='do']
  node={'a':a,'b':b,'s':s0,'guards':guards,'loops':active_loops}
  nodes.append(node)
  rest=s
  inline=None
  if re.match(r'if\\s*\\(',sl):
   cond,tail=paren_contents(s)
   if tail and tail.lower().startswith('then'):
    stack.append({'kind':'if','a':a,'b':b,'branch_a':a,'branch_b':b,'tests':['('+cond+')'],'active':cond});continue
   if cond is not None:inline=cond;rest=tail
  if re.match(r'select\\s*case\\s*\\(',sl):
   cond,_=paren_contents(s);stack.append({'kind':'select','a':a,'b':b,'branch_a':a,'branch_b':b,'selector':cond,'cases':[],'active_case':None});continue
  dm=re.match(r'(?:(\\w+)\\s*:\\s*)?do\\b\\s*(.*)',s,re.I)
  if dm:
   dl=dm[2];lm=re.match(r'(\\d+)\\s*,?\\s*(.*)',dl)
   obj={'kind':'do','a':a,'b':b,'end':p['line_end'],'name':dm[1],'label':lm[1] if lm else None,'s':s}
   stack.append(obj);loops.append(obj)
  em=re.match(r'(stop|return|exit|cycle)\\b\\s*(.*)',rest or '',re.I)
  term_call=re.match(r'call\\s+(halt_program|report_file_read_error)\\b\\s*(.*)',rest or '',re.I)
  gm=re.match(r'go\\s*to\\s+(\\d+)',rest or '',re.I)
  if em or term_call or gm:
   e=copy.copy(node);e['guards']=list(guards)
   if inline:e['guards'].append((a,b,inline))
   if em:
    e['kind']=em[1].lower();name=em[2].strip()
    e['targetloop']=next((x for x in reversed(active_loops) if not name or x['name']==name),None) if e['kind'] in ('cycle','exit') else None
   elif gm:e['kind']='goto';e['label']=gm[1]
   else:
    e['kind']=term_call[1].lower()
    if e['kind']=='halt_program' and term_call[2] and term_call[2].strip() not in ['','()']:e['kind']='conditional_halt_program'
   events.append(e)
  if label:
   while stack and stack[-1]['kind']=='do' and stack[-1]['label']==label[1]:
    stack[-1]['end']=b;stack.pop()
 return {'nodes':nodes,'events':events,'loops':loops,'labels':labels,'issues':issues}
flows={id:parse_proc(procs[id]) for id in {cands[r['id']]['caller'] for r in records}}
def guard_text(g):
 if isinstance(g,str):return g
 _,x,v=g
 vals=x['cases'] if v is None else [v]
 terms=[x['selector']+' IN {'+vs+'}' for vs in vals]
 out=' .or. '.join('('+t+')' for t in terms)
 return '.not.('+out+')' if v is None else out
def influencing_events(c):
 f=flows[c['caller']];n=c['line_start']
 node=next((x for x in f['nodes'] if x['a']<=n<=x['b']),None)
 if node is None:return []
 cl={x['a'] for x in node['loops']};out=[]
 for e in f['events']:
  prior=e['b']<n;common=cl & {x['a'] for x in e['loops']}
  affects=False;history=False
  if e['kind'] in ['stop','return','halt_program','report_file_read_error']:
   affects=prior or bool(common);history=bool(common)
  elif e['kind'] in ['exit','cycle'] and e['targetloop']:
   inloop=e['targetloop']['a'] in cl
   affects=inloop and (prior or e['kind']=='exit');history=inloop and e['kind']=='exit'
  elif e['kind']=='goto':
   dest=f['labels'].get(e['label'])
   affects=dest is not None and prior and n<dest
   escapes=[x for x in e['loops'] if x['a'] in cl and dest is not None and not(x['a']<=dest<=x['end'])]
   if escapes:affects=True;history=True
  if affects and e['a']"'!=n:out.append((e,history))
 return out

snippet('"'models/XBeach/raw/source_code/trunk/src/xbeachlibrary/ncoutput.F90',907,1026)
stats=collections.Counter();examples={}
for r in records:
 for e,h in influencing_events(cands[r['id']]):
  if e['kind'] not in ['stop','return','exit','cycle','goto']:continue
  if cands[r['id']]['caller']=='src/xbeachlibrary/ncoutput.F90:685:ncoutput':continue
