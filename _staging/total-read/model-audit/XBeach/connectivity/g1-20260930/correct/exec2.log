        for a,bend in reversed(spans):
            expr = expr[:a] + expr[bend:]
        assert not any(f'not_taken({t};' in expr for t in expected)
        b['applicability']['runtime']['expr'] = expr
    src = call_ev(r)['path']
    anchors = lines | set(also_remove)
    r['evidence'] = [e for e in r['evidence'] if not (
        e['path']==src and e['role']=='prior_exit' and
        e['line_start']==e['line_end'] and e['line_start'] in anchors)]
    # Removed termination witnesses remain useful only where another earlier
    # termination event is still described. Do not leave a prior_termination
    # claim after removing all predecessor events of a branch-only finding.
    if all('not_taken(' not in b['applicability']['runtime']['expr'] for b in r['bindings']):
        r['evidence'] = [e for e in r['evidence'] if not (
            e['role']=='prior_termination' and e['path'] in {LIB+'xmpi.F90',LIB+'logging.F90'})]
    ctx = [ev(src,a,b,role='runtime_control') for a,b in context]
    add_evidence(r,*ctx)
    removed_events.setdefault(n,set()).update(expected)
    prior_summaries[n].append('Removed infeasible predecessor '+', '.join(sorted(expected))+' and its prior-exit witness; retained the selected branch and other feasible history.')
    prior_witnesses[n].extend(ctx)

def add_history(n, event, ln, scope, guards, context=()):
    r = N[n]
    src = call_ev(r)['path']
    text = source(src)[ln-1]
    assert re.search(r'\\bcall\\s+'+re.escape(event)+r'\\b',text,re.I), (n,ln,text)
    guard = ' .and. '.join(f'(at_guard({a}, ({p})))' for a,p in guards)
    term = f' .and. (not_taken({event}@{ln}; before_this_call; scope={scope}; guard={guard}))'
    for b in r['bindings']:
        runtime = b['applicability']['runtime']
        assert f'not_taken({event}@{ln};' not in runtime['expr'], (n,ln)
        runtime['expr'] += term
    items = [ev(src,ln,role='prior_exit')]
    items += [ev(src,a,b,role='runtime_control') for a,b in context]
    items += [ev(src,a,role='runtime_control') for a,p in guards]
    add_evidence(r,*items)
    prior_witnesses[n].extend(items)
    added_events.setdefault(n,set()).add(f'{event}@{ln}')
    prior_summaries[n].append(f'Added {event}@{ln} survival over {scope}, with historical source guards.')

