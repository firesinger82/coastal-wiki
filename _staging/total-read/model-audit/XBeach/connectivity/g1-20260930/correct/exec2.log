1065:    subroutine space_collect_index(sg,sl,par,index)
1066:       use xmpi_module
1067:       use mnemmodule
1068:       use logging_module
1069:       use params
1070:       type(spacepars)                 :: sg
1071:       type(spacepars), intent(in)     :: sl
