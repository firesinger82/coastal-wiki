# Project link witnesses are checked directly by configuration, without
# investigating any MPI implementation.
def project_configs(path):
    result, current = [], None
    for ln,txt in enumerate(source(path),1):
        m = re.search(r'<Configuration Name=\"(["'^"]+)"'"',txt)
        if m:
            current = dict(name=m.group(1),start=ln)
            result.append(current)
        if current is not None and 'Name=\"VFFortranCompilerTool\"' in txt:
            d = re.search(r'PreprocessorDefinitions=\"(["'^"]*)"'"',txt)
            current['cpp_line'] = ln
            current['usempi'] = 'USEMPI' in (d.group(1).split(';') if d else [])
        if current is not None and re.search(r'Name=\"(?:VFLibrarianTool|VFLinkerTool)\"',txt):
            d = re.search(r'AdditionalDependencies=\"(["'^"]*)"'"',txt)
            if d:
                current['deps_line'] = ln
                current['deps'] = d.group(1)
    assert all('cpp_line' in c and 'usempi' in c for c in result)
    return result
