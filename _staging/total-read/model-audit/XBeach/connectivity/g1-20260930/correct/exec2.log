                      ev(GEN+'writelog.inc',662,role='compatibility')])
        req = f'A-K1: KIND(par%{component})=8 (DOUBLE PRECISION), equal to REAL*8 kind for af_message_float1.'
    elif name == 'snappointstogrid':
        assert n == 121
        req = 'A-K1: KIND(xpoints)=KIND(ypoints)=4 (default INTEGER), equal to INTEGER*4 kind for the rank-1 INOUT dummies.'
        items.extend([ev(LIB+'ncoutput.F90',105,106,role='compatibility'),
                      ev(LIB+'postprocess.F90',62,63,role='compatibility')])
    elif name == 'space_distribute':
        assert n == 2
        req = 'A-K1: KIND(sg%ee_s)=KIND(s%ee_s)=8 (DOUBLE PRECISION), equal to REAL*8 kind for a and b; rank-2 sections are preserved.'
        items.extend([ev(GEN+'spacedecl.inc',89,role='compatibility'),
