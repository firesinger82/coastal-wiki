allowed = {v['id'] for v in V}
source_cache = {}
def source(path):
    if path not in source_cache:
        blob = Path(path).read_bytes()
        assert path in manifest, ('source outside frozen manifest', path)
        assert hashlib.sha256(blob).hexdigest() == manifest[path], ('source changed', path)
        source_cache[path] = blob.decode('utf-8', errors='replace').splitlines()
    return source_cache[path]
def ev(path, a, b=None, role='runtime_control'):
    b = a if b is None else b
    L = source(path)
    assert 1 <= a <= b <= len(L)
    return dict(role=role, path=path, line_start=a, line_end=b,
                quote='\\n'.join(L[a-1:b]), sha256=manifest[path])
def add_evidence(r, *items):
    for e in items:
        if not any((x['role'], x['path'], x['line_start'], x['line_end']) ==
                   (e['role'], e['path'], e['line_start'], e['line_end']) for x in r['evidence']):
            r['evidence'].append(copy.deepcopy(e))
def call_ev(r):
    return next(e for e in r['evidence'] if e['role'] == 'call_site')
def call_text(r):
    e = call_ev(r)
    return '\\n'.join(source(e['path'])[e['line_start']-1:e['line_end']])
def matching_paren(s, start):
    assert s[start] == '('
    depth, quote, i = 0, None, start
    while i < len(s):
        c = s[i]
        if quote:
            if c == quote:
                if i+1 < len(s) and s[i+1] == quote:
                    i += 2
                    continue
                quote = None
        elif c in \"'\\\"\":
            quote = c
        elif c == '(':
            depth += 1
        elif c == ')':
            depth -= 1
            if depth == 0:
                return i+1
        i += 1
