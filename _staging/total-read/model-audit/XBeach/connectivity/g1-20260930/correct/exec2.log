1081: #endif
1082: 
1083:       if (xomaster) then
1084:          iscollected = sg%collected(index)
1085:       endif
1086: 
1087:       call MPI_Bcast(iscollected,1,MPI_LOGICAL,xmpi_omaster,xmpi_ocomm,ierr)
1088: 
1089:       ! return if this alreay has been collected
1090:       if(iscollected) then
1091:          return
1092:       endif
1093: 
1094: #ifdef USEMPI
1095:       if (xomaster) then
1096:          call index_allocate(sg,par,index,'r')
1097:       endif
1098: #endif
1099: 
1100:       call indextos(sl,index,tl)
1101:       call indextos(sg,index,tg)
1102: 
1103:       select case(tl%type)
1104:        case('i')
1105:          select case(tl%rank)
1106:           case(0)             ! nothing to do
1107:           case(2)
1108:             call space_collect(sl, tg%i2, tl%i2)
1109:           case(3)
1110:             call space_collect(sl, tg%i3, tl%i3)
1111:           case default     ! case 1 and 4 are not handled
1112:             goto 100
1113:          end select   ! rank
1114:        case('r')
1115:          select case(tl%rank)
1116:           case(0)             ! nothing to do
1117:           case(2)
1118:             !if (tl%name .eq. mnem_umean) then
1119:             !  goto 100
1120:             !endif
1121:             call space_collect(sl,tg%r2,tl%r2)
1122:           case(3)
1123:             call space_collect(sl,tg%r3,tl%r3)
1124:           case(4)
1125:             call space_collect(sl,tg%r4,tl%r4)
1126:           case default
1127:          end select   ! rank
1128:        case default
1129:       end select   ! type
1130: 
1131: #ifdef USEMPE
1132:       call MPE_Log_event(event_coll_start,0,'cend')
1133: #endif
1134: 
1135:       sg%collected(index) = .true.
1136:       return
1137: 
