    # are kept intact. Continued source lines are joined without comments.
    txt = call_text(r)
    txt = re.sub(r'&\\s*\\n\\s*&?', ' ', txt)
    m = re.search(r'\\b' + re.escape(name) + r'\\s*\\(', txt, re.I)
    assert m, (r['id'], txt)
    a = m.end()-1
    b = matching_paren(txt, a)
    payload = txt[a+1:b-1]
    parts, start, depth, quote, i = [], 0, 0, None, 0
    while i < len(payload):
        c = payload[i]
        if quote:
            if c == quote:
                if i+1 < len(payload) and payload[i+1] == quote:
                    i += 2
                    continue
                quote = None
        elif c in \"'\\\"\":
            quote = c
        elif c == '(':
            depth += 1
        elif c == ')':
            depth -= 1
        elif c == ',' and depth == 0:
            parts.append(payload[start:i].strip())
            start = i+1
        i += 1
    parts.append(payload[start:].strip())
    return parts

