{
  "allowed_outputs": [
    "tasks/_example/outputs/*"
  ],
  "budget": {
    "codex_runs": 4,
    "max_records": 10,
    "wall_hours": 1
  },
  "build_plan_levels": {
    "not_performed": [
      "코드 구현",
      "실행 확인",
      "수치 검증",
      "물리 검증"
    ],
    "target": [
      "문서 지원"
    ]
  },
  "constraints": [
    "Only produce the example output."
  ],
  "done_when": [
    {
      "id": "purpose",
      "kind": "review",
      "spec": "이 산출물이 function_question 에 답하는가? done_when 이 그 질문에 비해 과하거나(전수·소진형) 모자라지 않은가?"
    },
    {
      "id": "artifact",
      "kind": "check",
      "spec": {
        "path": "tasks/_example/outputs/result.txt",
        "type": "exists"
      }
    }
  ],
  "function": "example",
  "function_question": "Does the output contain the approved example result?",
  "inputs": [],
  "model": "example",
  "out_of_scope": [
    "Unrelated dependencies and exhaustive inventory"
  ],
  "revision": 1,
  "task_id": "_example",
  "verifier": {
    "family": "anthropic",
    "second_for_models": true
  }
