{
  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowAllClaudeAiMcps": false,
  "disableSideloadFlags": true,
  "strictPluginOnlyCustomization": true,
  "disableAutoMode": "disable",
  "disableArtifact": true,
  "disableClaudeAiConnectors": true,
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Agent(resume-code-reader)",
      "Agent(resume-pdf-reader)",
      "mcp__resume-submit__submit"
    ],
    "deny": [
      "Bash",
      "PowerShell",
      "Write",
      "Edit",
      "NotebookEdit",
      "Artifact",
      "EnterWorktree",
      "ExitWorktree",
      "WebFetch",
      "WebSearch",
      "Monitor",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "RemoteTrigger",
      "Skill",
      "Workflow",
      "SendMessage",
      "TaskCreate",
      "TaskUpdate",
      "PushNotification"
    ]
  },
  "allowedMcpServers": [
    {
      "serverName": "resume-submit"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/coastal-resume/bin/resume-pretool-guard",
            "args": []
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/coastal-resume/bin/resume-stop-gate",
            "args": []
          }
        ]
      }
    ]
  }
}
