{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coastal task v1.1 verdict",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_sha256s": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "checker_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_sha256s": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "enum": [
        "purpose",
        "output"
      ]
    },
    "actual_model": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_][a-z0-9_-]{0,63}$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "UNCERTAIN"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "verdict",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "task_id",
    "revision",
    "contract_sha256",
    "input_sha256s",
    "checker_sha256",
    "output_sha256s",
    "run_id",
    "phase",
    "actual_model",
    "questions"
  ],
  "additionalProperties": false
}
